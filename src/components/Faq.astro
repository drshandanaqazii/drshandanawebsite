---
/**
 * The homepage's five questions.
 *
 * Two columns: the subject and a standing invitation to call on the left, the
 * questions themselves on the right as separate cards rather than one ruled
 * stack. The card on the left is the point of the layout — a list that only
 * answers five questions leaves the reader who still has a sixth with nowhere
 * to go, so the answer to that (bring it to the appointment) and the number to
 * book on sit beside the list the whole way down.
 *
 * No FAQPage structured data here, deliberately — these five are a subset of
 * /faq, and the same question-and-answer pairs marked up on two URLs is a
 * duplicate signal rather than two chances at a rich result. /faq carries the
 * markup for all of them. See the note in consts.ts.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { FAQS, ALL_FAQS, DOCTOR, PRACTICE } from '../consts';
import { TEL_HREF } from '../lib/practice-links';
import portrait from '../assets/shandana-portrait.png';
---

<section class="section section--band" id="faq" aria-labelledby="faq-heading">
  <div class="container faq">
    <div class="faq__head" data-reveal-group>
      <p class="eyebrow" data-reveal>Questions</p>
      <h2 class="display-md" id="faq-heading" data-reveal>
        Things people ask <em>first</em>
      </h2>

      {/* The card carries what the old subline said, but attached to a face and
          a number — the same sentence with nothing to act on was easy to read
          past. */}
      <div class="faq__card" data-reveal style="--reveal-from: 14px;">
        <figure class="faq__avatar">
          <Image
            src={portrait}
            alt={DOCTOR.name}
            widths={[160]}
            sizes="80px"
            loading="lazy"
          />
        </figure>

        <p class="card-title faq__card-title">Bring it to the appointment</p>
        <p class="body-sm faq__card-body">
          If your question is not here, ask it at the consultation. There is time set
          aside for exactly that, and nothing is too small to raise.
        </p>

        <div class="faq__card-cta">
          <Button href={TEL_HREF} icon="phone" external>
            {PRACTICE.bookingPhoneDisplay}
          </Button>
        </div>
      </div>
    </div>

    <div class="faq__list" data-reveal-group>
      {FAQS.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0} data-reveal style="--reveal-from: 10px;">
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__sign" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p class="body-sm">{item.a}</p></div>
        </details>
      ))}

      <div class="faq__more" data-reveal style="--reveal-from: 10px;">
        <Button href="/faq" variant="ghost">All {ALL_FAQS.length} questions</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 380px) 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .faq__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
    position: sticky;
    top: 108px;
  }

  /* --- the call card ---------------------------------------------------- */

  .faq__card {
    width: 100%;
    margin-top: var(--s-3);
    padding: var(--s-6) var(--s-5) var(--s-5);
    border-radius: var(--r-card);
    /* A lifted white surface on an already-off-white band needs the edge before
       the shadow; the tint runs top-down so the card lightens into its own
       button rather than sitting as a flat block of colour. */
    background: linear-gradient(175deg, var(--amethyst-50), var(--paper) 62%);
    box-shadow: inset 0 0 0 1px var(--hairline), var(--shadow-card);
  }

  .faq__avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--amethyst-100);
    box-shadow: 0 0 0 4px var(--paper), 0 0 0 5px var(--hairline);
  }

  /* The source is a square, chest-up cut-out, so a crop alone frames nothing —
     the circle is filled by scaling in on the face instead. The origin sits
     above the face, not on it: scaling about the face itself is what pushed the
     top of her head past the edge of the circle. Keep the head fully inside. */
  .faq__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
    transform-origin: 50% 22%;
  }

  .faq__card-title { margin-top: var(--s-4); }
  .faq__card-body { margin-top: var(--s-2); color: var(--ink-body); }
  .faq__card-cta { margin-top: var(--s-5); }

  /* --- the questions ---------------------------------------------------- */

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Cards, not a ruled stack: each question is its own thing to open, and on a
     tinted band a white panel separates them without a single rule. */
  .faq__item {
    border-radius: var(--r-media);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow var(--dur-fast) var(--ease);
  }

  .faq__item:hover { box-shadow: inset 0 0 0 1px var(--amethyst-100); }

  .faq__item[open] {
    box-shadow: inset 0 0 0 1px var(--amethyst-100), var(--shadow-card);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    padding: 20px clamp(20px, 2.2vw, 28px);
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 450;
    line-height: 1.45;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--amethyst-600); }

  .faq__item[open] .faq__q { color: var(--ink); padding-bottom: 12px; }

  /* The +/× is drawn, not typed, so it can rotate cleanly */
  .faq__sign {
    position: relative;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--ink-muted);
  }
  .faq__sign::before,
  .faq__sign::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.25px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }
  .faq__sign::after { transform: rotate(90deg); }

  .faq__item[open] .faq__sign { color: var(--amethyst-600); }
  .faq__item[open] .faq__sign::before { transform: rotate(45deg); }
  .faq__item[open] .faq__sign::after { transform: rotate(135deg); }

  .faq__a { padding: 0 clamp(20px, 2.2vw, 28px) 22px; }
  .faq__a p { max-width: 62ch; }

  .faq__more { margin-top: var(--s-3); }

  @media (max-width: 1000px) {
    .faq { grid-template-columns: 1fr; }
    .faq__head { position: static; }
    .faq__card { max-width: 420px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__sign::before, .faq__sign::after { transition: none; }
  }
</style>
