---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { CLINIC_GALLERY } from '../data/clinic-gallery';

const { photos, preview } = CLINIC_GALLERY;
---

<section class="section section--band clinic-gallery" id="clinic-photos" aria-labelledby="gallery-heading">
  <div class="container">
    <div class="section-head section-head--center gallery-heading" data-reveal-group>
      <p class="eyebrow" data-reveal>Clinic gallery</p>
      <h2 class="display-md" id="gallery-heading" data-reveal>A closer <em>look</em>.</h2>
      {preview && <p class="body-sm gallery-note" data-reveal>Illustrative previews — photographs of Salma Psychiatric Clinic will follow.</p>}
    </div>
  </div>

  <clinic-gallery aria-label="Clinic photo gallery" role="region" aria-roledescription="carousel">
    <div class="gallery-stage" tabindex="0" aria-label="Photos. Use the left and right arrow keys to browse.">
      {photos.map((photo, index) => (
        <figure class="gallery-photo" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${photos.length}: ${photo.alt}`}>
          <Image src={photo.src} alt={photo.alt} widths={[320, 560, 800]} sizes="(max-width: 640px) 66vw, 360px" loading="lazy" style={`object-position: ${photo.position ?? '50% 50%'}`} />
        </figure>
      ))}
    </div>
    <div class="gallery-nav" hidden>
      <button class="gallery-button gallery-button--prev" type="button" data-prev aria-label="Previous photo"><Icon name="arrow" /></button>
      <p class="gallery-status" role="status" aria-live="polite" aria-atomic="true"></p>
      <button class="gallery-button" type="button" data-next aria-label="Next photo"><Icon name="arrow" /></button>
    </div>
  </clinic-gallery>
</section>

<style>
  .clinic-gallery.section--band { padding-block: clamp(48px, 6vw, 80px); overflow: hidden; background: var(--paper); }
  .gallery-heading { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 12px; }
  .gallery-note { color: var(--ink-muted); max-width: 48ch; margin-inline: auto; }
  clinic-gallery { display: block; }
  /* With no script, every photograph remains available in a scrollable row. */
  .gallery-stage {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding: 32px 24px;
    scroll-snap-type: x mandatory;
  }
  .gallery-photo {
    position: relative;
    flex: 0 0 min(72vw, 360px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--r-card);
    background: var(--amethyst-100);
    box-shadow: 0 16px 36px rgba(26, 22, 34, .15);
    scroll-snap-align: center;
  }
  .gallery-photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  clinic-gallery[data-ready] .gallery-stage {
    --gallery-step: clamp(155px, 20vw, 250px);
    position: relative;
    display: block;
    height: 480px;
    overflow: hidden;
    perspective: 1400px;
    scroll-snap-type: none;
    touch-action: pan-y;
  }
  clinic-gallery[data-ready] .gallery-photo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 340px;
    margin: 0;
    transform: translate(-50%, -50%) translateX(calc(var(--slot) * var(--gallery-step))) scale(var(--scale)) rotateY(var(--angle));
    z-index: var(--depth);
    filter: brightness(var(--brightness));
    transition: transform 550ms var(--ease), filter 550ms var(--ease), opacity 550ms var(--ease);
  }
  .gallery-nav { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: 8px; padding-inline: 20px; }
  .gallery-nav[hidden] { display: none; }
  .gallery-button {
    display: grid;
    place-items: center;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .gallery-button:hover { background: var(--amethyst-900); color: white; }
  .gallery-button--prev :global(.icon) { transform: rotate(180deg); }
  .gallery-status { width: 190px; text-align: center; color: var(--ink-body); font-size: var(--fs-body-sm); font-variant-numeric: tabular-nums; }
  .gallery-button:focus-visible, .gallery-stage:focus-visible { outline: 2px solid var(--amethyst-600); outline-offset: -3px; }
  @media (max-width: 640px) {
    clinic-gallery[data-ready] .gallery-stage { --gallery-step: 36vw; height: 360px; }
    clinic-gallery[data-ready] .gallery-photo { width: min(66vw, 260px); }
    .gallery-nav { gap: 12px; margin-top: 0; }
    .gallery-status { width: 160px; font-size: .75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    clinic-gallery[data-ready] .gallery-photo, .gallery-button { transition: none; }
  }
</style>

<script>
  class ClinicGallery extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const stage = this.querySelector<HTMLElement>('.gallery-stage');
      const photos = Array.from(this.querySelectorAll<HTMLElement>('.gallery-photo'));
      const nav = this.querySelector<HTMLElement>('.gallery-nav');
      const status = this.querySelector<HTMLElement>('.gallery-status');
      const prev = this.querySelector<HTMLButtonElement>('[data-prev]');
      const next = this.querySelector<HTMLButtonElement>('[data-next]');
      if (!stage || !nav || !status || !prev || !next || photos.length < 2) return;

      const events = new AbortController();
      const options = { signal: events.signal };
      let current = Math.floor(photos.length / 2);
      const paint = () => {
        photos.forEach((photo, index) => {
          let slot = (index - current + photos.length) % photos.length;
          if (slot > photos.length / 2) slot -= photos.length;
          const distance = Math.abs(slot);
          photo.style.setProperty('--slot', String(slot));
          photo.style.setProperty('--scale', String(Math.max(.5, 1 - distance * .17)));
          photo.style.setProperty('--angle', String(-slot * 8) + 'deg');
          photo.style.setProperty('--depth', String(photos.length - distance));
          photo.style.setProperty('--brightness', String(Math.max(.6, 1 - distance * .12)));
          photo.style.opacity = distance > 2 ? '0' : '1';
          photo.setAttribute('aria-hidden', String(slot !== 0));
        });
        status.textContent = String(current + 1).padStart(2, '0') + ' / ' + String(photos.length).padStart(2, '0');
      };
      const go = (step: number) => {
        current = (current + step + photos.length) % photos.length;
        paint();
      };
      prev.addEventListener('click', () => go(-1), options);
      next.addEventListener('click', () => go(1), options);
      this.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          go(event.key === 'ArrowLeft' ? -1 : 1);
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          current = event.key === 'Home' ? 0 : photos.length - 1;
          paint();
        }
      }, options);
      let gesture: { x: number; y: number; id: number } | null = null;
      stage.addEventListener('pointerdown', (event) => {
        if (!event.isPrimary || event.button !== 0) return;
        gesture = { x: event.clientX, y: event.clientY, id: event.pointerId };
        stage.setPointerCapture(event.pointerId);
      }, options);
      stage.addEventListener('pointerup', (event) => {
        if (!gesture || gesture.id !== event.pointerId) return;
        const dx = event.clientX - gesture.x;
        const dy = event.clientY - gesture.y;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(dx < 0 ? 1 : -1);
        gesture = null;
      }, options);
      stage.addEventListener('pointercancel', () => { gesture = null; }, options);
      stage.addEventListener('dragstart', (event) => event.preventDefault(), options);
      paint();
      this.dataset.ready = '';
      nav.hidden = false;
      this.cleanup = () => events.abort();
    }
    disconnectedCallback() { this.cleanup?.(); }
  }
  if (!customElements.get('clinic-gallery')) customElements.define('clinic-gallery', ClinicGallery);
</script>
