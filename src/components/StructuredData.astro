---
/**
 * JSON-LD for local + medical search.
 *
 * One @graph per page. Three of the nodes describe the practice and are
 * identical on every page — they carry stable `@id`s, so a crawler reading four
 * pages sees one Physician referenced four times rather than four physicians:
 *
 *   Physician            the entity Google's local pack ranks
 *   MedicalOrganization  RMI, as her affiliation and employer
 *   WebSite              the site itself
 *
 * The rest are page-specific and are built from the props below:
 *
 *   WebPage / MedicalWebPage / AboutPage / ContactPage / CollectionPage
 *   BreadcrumbList       wherever the page sits below the root
 *   FAQPage              only where the page actually carries questions
 *   MedicalCondition     the subject of a service page
 *
 * `Physician` is a subtype of MedicalBusiness → LocalBusiness, which is what
 * makes address, geo and openingHours meaningful for "psychiatrist in Peshawar".
 *
 * One rule worth keeping: a FAQPage node belongs on exactly one URL per set of
 * questions. The homepage shows five of the questions from /faq and deliberately
 * passes no `faqs` prop, because the same Q&A marked up twice is a duplicate
 * signal rather than two chances at a rich result.
 */
import {
  SITE,
  DOCTOR,
  PRACTICE,
  SALMA,
  BOOKING_VENUE,
  ACADEMIC_ROLES,
  SERVICE_KEYWORDS,
  MODALITIES,
  SEO,
} from '../consts';

type PageType =
  | 'WebPage'
  | 'AboutPage'
  | 'ContactPage'
  | 'CollectionPage'
  | 'MedicalWebPage';

interface Props {
  /** Absolute, no trailing slash. Supplied by BaseLayout. */
  canonical: string;
  title: string;
  description: string;
  pageType?: PageType;
  /** Root is implicit and is prepended — pass only the levels below it. */
  breadcrumbs?: readonly { name: string; href: string }[];
  faqs?: readonly { q: string; a: string }[];
  condition?: { name: string; alternateName: readonly string[]; description: string };
}

const {
  canonical,
  title,
  description,
  pageType = 'WebPage',
  breadcrumbs = [],
  faqs = [],
  condition,
} = Astro.props;

const base = SITE.url.replace(/\/$/, '');
const abs = (path: string) => (path.startsWith('http') ? path : `${base}${path}`);

const physicianId = `${base}/#physician`;
const orgId = `${base}/#rmi`;
const websiteId = `${base}/#website`;
const webpageId = `${canonical}#webpage`;
const conditionId = `${canonical}#condition`;

/* -- The practice. Identical on every page, by design. --------------------- */

const practiceNodes = [
  {
    '@type': SALMA.located ? ['Physician', 'MedicalBusiness'] : 'Physician',
    '@id': physicianId,
    name: DOCTOR.name,
    alternateName: `${DOCTOR.givenName} ${DOCTOR.familyName}`,
    honorificPrefix: DOCTOR.honorificPrefix,
    honorificSuffix: DOCTOR.qualifications,
    givenName: DOCTOR.givenName,
    familyName: DOCTOR.familyName,
    gender: 'Female',
    jobTitle: DOCTOR.jobTitle,
    description: SEO.description,
    url: base,
    image: `${base}/og-image.jpg`,
    /* NAP follows the bookable venue, not the hospital. This node is the entity
       Google's local pack ranks, so its address, coordinates, phone and hours
       have to be the place a patient is actually asked to turn up at — the
       moment they describe a different building from the one on /contact, the
       listing and the site disagree and the listing is what loses. */
    email: PRACTICE.email,
    priceRange: 'PKR',
    medicalSpecialty: 'Psychiatric',
    knowsLanguage: DOCTOR.languages,

    ...(SALMA.located ? { address: {
      '@type': 'PostalAddress',
      streetAddress: BOOKING_VENUE.address.street,
      addressLocality: BOOKING_VENUE.address.locality,
      addressRegion: BOOKING_VENUE.address.region,
      postalCode: BOOKING_VENUE.address.postalCode,
      addressCountry: BOOKING_VENUE.address.country,
    } } : {}),

    ...(SALMA.located ? { geo: {
      '@type': 'GeoCoordinates',
      latitude: BOOKING_VENUE.geo.lat,
      longitude: BOOKING_VENUE.geo.lng,
    } } : {}),

    // The catchment this practice actually serves.
    areaServed: [
      { '@type': 'City', name: 'Peshawar' },
      { '@type': 'AdministrativeArea', name: 'Khyber Pakhtunkhwa' },
    ],

    ...(BOOKING_VENUE.hours.length > 0 && { openingHoursSpecification: BOOKING_VENUE.hours.map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days,
      opens: h.opens,
      closes: h.closes,
    })) }),
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Appointment enquiries',
      url: `https://wa.me/${SALMA.whatsapp}`,
    },

    hasCredential: [
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'degree',
        name: 'MBBS',
      },
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'Fellowship',
        name: 'FCPS (Psychiatry)',
        recognizedBy: {
          '@type': 'Organization',
          name: 'College of Physicians and Surgeons Pakistan',
        },
      },
      /* No `recognizedBy` — the awarding institution has not been supplied yet.
         An omitted property is a gap; a guessed one is a false statement about a
         qualification, which is the worst kind of thing to be wrong about here.
         Add it when consts.ts gets it. */
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'diploma',
        name: 'Diploma in Islamic Psychotherapy',
      },
      {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'certificate',
        name: 'Psychological First Aid',
      },
    ],

    /* The posts, as distinct from the qualifications above. This is what tells a
       crawler that the same person who consults at RMI heads a department and
       directs a course at the college — which is the substance behind every
       "expertise" claim on the site, and the part a credential list alone does
       not carry. Built from ACADEMIC_ROLES so the schema and /about state the
       same three jobs. */
    hasOccupation: ACADEMIC_ROLES.map((r) => ({
      '@type': 'Occupation',
      name: r.title,
      occupationLocation: { '@type': 'City', name: PRACTICE.address.locality },
      description: `${r.title}, ${r.org}`,
    })),

    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'Rehman Medical College',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Peshawar',
        addressCountry: 'PK',
      },
    },

    /* `worksFor` follows the practice she is booked through; `affiliation`
       always names RMI. Once the clinic is her primary practice those are two
       genuinely different organisations, and collapsing them onto the hospital
       would say she is employed by RMI to do work she does at her own clinic. */
    worksFor: { '@id': `${base}/#salma` },
    affiliation: { '@id': orgId },

    // MODALITIES, not the service list: a condition is not a MedicalProcedure.
    // Those are declared as knowsAbout below.
    availableService: MODALITIES.map((m) => ({
      '@type': 'MedicalProcedure',
      name: m.name,
      description: m.body,
    })),

    knowsAbout: SERVICE_KEYWORDS,
    /* Her RMI consultant profile verifies the credentials; the clinic's
       Instagram is the only other public account that belongs to this practice.
       Two independent corroborations of one practitioner is what `sameAs` is
       worth having for. */
    sameAs: [SALMA.instagram],
  },

  {
    '@type': ['MedicalOrganization', 'Hospital'],
    '@id': orgId,
    name: PRACTICE.affiliation,
    alternateName: PRACTICE.affiliationShort,
    telephone: PRACTICE.hospitalPhone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: PRACTICE.address.street,
      addressLocality: PRACTICE.address.locality,
      addressRegion: PRACTICE.address.region,
      addressCountry: PRACTICE.address.country,
    },
  },

  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: base,
    name: `${DOCTOR.name}, ${DOCTOR.jobTitle}`,
    inLanguage: 'en',
    publisher: { '@id': physicianId },
  },
];

/* -- This page. ------------------------------------------------------------ */

const webpage: Record<string, unknown> = {
  '@type': pageType,
  '@id': webpageId,
  url: canonical,
  name: title,
  description,
  isPartOf: { '@id': websiteId },
  about: condition ? { '@id': conditionId } : { '@id': physicianId },
  primaryImageOfPage: `${base}/og-image.jpg`,
  inLanguage: 'en',
};

if (pageType === 'MedicalWebPage') {
  // Tells Google what kind of medical page this is, which is what separates a
  // service page from a marketing page in the health results.
  webpage.specialty = 'https://schema.org/Psychiatric';
  webpage.audience = { '@type': 'Patient' };
  webpage.mainContentOfPage = { '@type': 'WebPageElement', cssSelector: '#main' };
}

if (breadcrumbs.length) {
  webpage.breadcrumb = { '@id': `${canonical}#breadcrumb` };
}

const graph: Record<string, unknown>[] = [...practiceNodes, webpage];

/* -- Salma Psychiatric Clinic, her own practice. ---------------------------
   Declared in two stages, because the clinic has a public identity before it
   has a published address and those are different claims:

   Stage one, now. A plain `Organization`: the clinic exists, it is called this,
   it has this page and this Instagram account, and Dr. Qazi works there. Every
   one of those is verifiable today. `Organization` is deliberately NOT a
   LocalBusiness — a LocalBusiness is a claim about a place on a map, and an
   address-less one competes with the RMI listing for the same practitioner with
   nothing for Google to place, so neither ranks cleanly.

   Stage two, once SALMA.located. It becomes a `MedicalClinic` with an address,
   coordinates and opening hours — a real local entity — and the Physician node
   above has already moved its own NAP onto the same building.

   `sameAs` carries the Instagram either way. With no Google Business Profile
   yet it is the only external corroboration that this practice is a real
   going concern, which is exactly the job `sameAs` exists to do.

   `employee` rather than a property on the Physician node: an Organization
   names a person that way, and it keeps a single `@id` for Dr. Qazi — she is
   one physician working at two places, not two physicians. */
graph.push({
  '@type': SALMA.located ? ['MedicalClinic', 'MedicalBusiness'] : 'MedicalOrganization',
  '@id': `${base}/#salma`,
  name: SALMA.name,
  alternateName: SALMA.shortName,
  url: `${base}/salma`,
  sameAs: [SALMA.instagram],
  employee: { '@id': physicianId },
  medicalSpecialty: 'Psychiatric',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'appointments',
    url: `https://wa.me/${SALMA.whatsapp}`,
  },
  ...(SALMA.located
    ? {
        medicalSpecialty: 'Psychiatric',
        ...(SALMA.phone ? { telephone: SALMA.phone } : {}),
        address: {
          '@type': 'PostalAddress',
          streetAddress: SALMA.address.street,
          addressLocality: SALMA.address.locality,
          addressRegion: SALMA.address.region,
          postalCode: SALMA.address.postalCode,
          addressCountry: SALMA.address.country,
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: SALMA.geo.lat,
          longitude: SALMA.geo.lng,
        },
        openingHoursSpecification: SALMA.hours.map((h) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: h.days,
          opens: h.opens,
          closes: h.closes,
        })),
      }
    : {}),
});

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.name,
      item: abs(crumb.href).replace(/\/$/, '') || base,
    })),
  });
}

if (condition) {
  graph.push({
    '@type': 'MedicalCondition',
    '@id': conditionId,
    name: condition.name,
    alternateName: [...condition.alternateName],
    description: condition.description,
    associatedAnatomy: { '@type': 'AnatomicalStructure', name: 'Brain' },
    relevantSpecialty: 'https://schema.org/Psychiatric',
    possibleTreatment: MODALITIES.map((m) => ({
      '@type': 'MedicalTherapy',
      name: m.name,
    })),
  });
}

if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    isPartOf: { '@id': websiteId },
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(jsonLd)}
/>
