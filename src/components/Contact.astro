---
/**
 * The booking section on the homepage.
 *
 * /contact carries the full version — directions, what to bring, the hours in
 * full. This is the short one, and it exists on the homepage for a reason
 * beyond convenience: clinic name and WhatsApp contact on the page that ranks for her
 * name is one of the signals the local pack reads, and it has to match the
 * clinic's current appointment details.
 */
import Button from './Button.astro';
import Icon from './Icon.astro';
import PracticeMap from './PracticeMap.astro';
import { BOOKING_VENUE, PRACTICE, SALMA } from '../consts';
---

<section class="section" id="contact" aria-labelledby="contact-heading">
  <div class="container clinic">
    <PracticeMap />

    <div class="clinic__copy" data-reveal-group>
      <div class="section-head" style="margin-bottom: var(--s-5);">
        <p class="eyebrow" data-reveal>Booking</p>
        <h2 class="display-md" id="contact-heading" data-reveal>
          {BOOKING_VENUE.name}, <em>by video</em>
        </h2>
        <p class="body-sm" data-reveal>
          Start with one conversation. Book an appointment and the clinic will confirm
          your time.
        </p>
      </div>

      <ul class="clinic__rows" data-reveal>
        <li class="clinic__row">
          <span class="clinic__icon"><Icon name="pin" size="sm" /></span>
          <div>
            <p class="clinic__label">Where you are seen</p>
            <address class="clinic__value">
              {BOOKING_VENUE.name}: by video, from anywhere<br />In person at {PRACTICE.address.street}, {PRACTICE.address.locality}
            </address>
          </div>
        </li>
        <li class="clinic__row">
          <span class="clinic__icon"><Icon name="clock" size="sm" /></span>
          <div>
            <p class="clinic__label">Clinic hours</p>
            <p class="clinic__value">{PRACTICE.hoursDisplay}</p>
          </div>
        </li>
        <li class="clinic__row">
          <span class="clinic__icon"><Icon name="whatsapp" size="sm" /></span>
          <div>
            <p class="clinic__label">Contact the clinic</p>
            <p class="clinic__value">WhatsApp · {SALMA.whatsappDisplay}</p>
          </div>
        </li>
      </ul>

      <div class="clinic__actions" data-reveal>
        <Button href="/appointments" book>Book an appointment</Button>
        <Button href="/appointments" variant="ghost">Appointment information</Button>
      </div>
      <p class="contact__more" data-reveal>
        <a href="/contact">Contact and visit information</a>
      </p>
    </div>
  </div>
</section>

<style>
  .clinic {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .clinic__rows {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--hairline);
  }
  .clinic__row {
    display: flex;
    align-items: flex-start;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--hairline);
  }
  .clinic__icon :global(.icon) { width: 26px; height: 26px; }
  .clinic__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline);
    color: var(--amethyst-600);
  }
  .clinic__label {
    margin-bottom: 5px;
    color: var(--ink-muted);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    letter-spacing: .01em;
  }
  .clinic__value {
    color: var(--ink);
    font-size: var(--fs-body-sm);
    font-style: normal;
    line-height: 1.7;
  }
  .clinic__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .contact__more { margin-top: var(--s-4); font-size: var(--fs-body-sm); font-weight: 500; }
  .contact__more a { text-underline-offset: 4px; }

  @media (max-width: 900px) {
    .clinic { grid-template-columns: 1fr; }
  }
</style>
