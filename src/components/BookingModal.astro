---
/**
 * The booking dialog, mounted once in BaseLayout.
 *
 * Anything carrying `data-book` opens it (`data-book="online"` preselects a
 * kind). The links keep a real href to /appointments, so with no JavaScript they
 * still lead somewhere useful.
 *
 * There is no backend. A request is written into a WhatsApp message to the
 * clinic, and the desk confirms it — the practice's existing way of booking.
 * The dialog therefore offers *requested* slots and says so. The message
 * carries a name, a number, a day and a time and nothing clinical; see the note
 * on WHATSAPP_TEXT in lib/practice-links.ts for why.
 *
 * Hours, slot length and notice period all live in data/booking.ts.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import portrait from '../assets/about-shandana.webp';
import { SALMA, DOCTOR, BOOKING_VENUE } from '../consts';
import {
  BOOKING_MODES,
  SLOT_MINUTES,
  BOOKING_WINDOW_DAYS,
  BOOKING_LEAD_MINUTES,
  BOOKING_TIMEZONE,
} from '../data/booking';
import { TEL_HREF } from '../lib/practice-links';

const config = {
  modes: BOOKING_MODES,
  slot: SLOT_MINUTES,
  windowDays: BOOKING_WINDOW_DAYS,
  lead: BOOKING_LEAD_MINUTES,
  tz: BOOKING_TIMEZONE,
  whatsapp: SALMA.whatsapp,
  doctor: DOCTOR.name,
};
---

<dialog class="book" id="book-dialog" aria-labelledby="book-title" data-config={JSON.stringify(config)}>
  <form class="book__panel" method="dialog" novalidate>
    <button class="book__close" type="button" data-book-close aria-label="Close booking">
      <Icon name="close" size="sm" />
    </button>

    <ol class="book__steps" aria-label="Progress">
      <li data-step-dot="1"><span>1</span> Appointment</li>
      <li data-step-dot="2"><span>2</span> Time</li>
    </ol>

    {/* ---- Step 1 ------------------------------------------------------ */}
    <section data-step="1">
      <h2 class="book__title" id="book-title">Choose an <em>appointment.</em></h2>
      <p class="book__sub">Step 1 of 2. How would you like to be seen?</p>

      <div class="book__who">
        <Image class="book__who-photo" src={portrait} alt="" width={112} height={112} loading="lazy" />
        <div class="book__who-text">
          <span class="book__who-label">You will be seeing</span>
          <strong>{DOCTOR.name}</strong>
        </div>
      </div>

      <p class="book__label book__label--choose" id="book-mode-label">Please choose one of the two</p>
      <div class="book__modes" role="radiogroup" aria-labelledby="book-mode-label">
        {BOOKING_MODES.map((m) => (
          <button class="book__mode" type="button" role="radio" aria-checked="false" data-mode={m.id}>
            <span class="book__mode-label">{m.label}</span>
            <span class="book__mode-where">{m.where}</span>
            <span class="book__mode-hours">{m.daysDisplay} · {m.hoursDisplay}</span>
          </button>
        ))}
      </div>

      <div class="book__foot">
        <button class="book__btn book__btn--ghost" type="button" data-book-close>Cancel</button>
        <button class="book__btn" type="button" data-next disabled>Continue</button>
      </div>
    </section>

    {/* ---- Step 2 ------------------------------------------------------ */}
    <section data-step="2" hidden>
      <h2 class="book__title">Pick a <em>time.</em></h2>
      <p class="book__sub" data-summary>Step 2 of 2. When suits you best?</p>

      <p class="book__label" id="book-day-label">Preferred day</p>
      <div class="book__chips" role="radiogroup" aria-labelledby="book-day-label" data-days></div>

      <p class="book__label" id="book-time-label">Preferred time</p>
      <p class="book__hint">Times are Pakistan time (PKT).</p>
      <p class="book__hint" data-time-hint>Choose a day to see its times.</p>
      <div class="book__chips" role="radiogroup" aria-labelledby="book-time-label" data-times></div>

      <div class="book__fields">
        <label class="book__field">
          <span class="book__label">Your name</span>
          <input type="text" name="name" autocomplete="name" placeholder="e.g. Ayesha Khan" maxlength="80" />
        </label>
        <label class="book__field">
          <span class="book__label">Phone number</span>
          <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="e.g. 0300 1234567" maxlength="20" />
        </label>
      </div>

      <p class="book__needed" data-needed role="status" aria-live="polite"></p>

      <div class="book__foot">
        <button class="book__btn book__btn--ghost" type="button" data-back>Back</button>
        <button class="book__btn" type="button" data-confirm disabled>Confirm booking</button>
      </div>
    </section>

    {/* ---- Done -------------------------------------------------------- */}
    <section data-step="3" hidden>
      <h2 class="book__title">Request <em>ready.</em></h2>
      <p class="book__sub" data-done-summary></p>
      <p class="book__done-note">
        WhatsApp should have opened with your request filled in. <strong>Press send there</strong> —
        the booking is not made until the clinic replies to confirm it. For an online appointment, that reply also tells you how the video call will reach you.
      </p>
      <div class="book__foot">
        <a class="book__btn book__btn--ghost" data-wa-link href="#" target="_blank" rel="noopener noreferrer">
          Open WhatsApp again
        </a>
        <button class="book__btn" type="button" data-book-close>Done</button>
      </div>
    </section>

    <p class="book__fine">
      Your slot is confirmed by the clinic over WhatsApp. Prefer to call?
      {BOOKING_VENUE.phoneDisplay && <a href={TEL_HREF}>{BOOKING_VENUE.phoneDisplay}</a>}
      {!BOOKING_VENUE.phoneDisplay && <a href={`https://wa.me/${SALMA.whatsapp}`} target="_blank" rel="noopener noreferrer">{SALMA.whatsappDisplay}</a>}
    </p>
  </form>
</dialog>

<style is:global>
  .book {
    width: min(640px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--r-hero);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 30px 80px rgba(26, 22, 34, .28);
    overflow: auto;
  }
  .book::backdrop { background: rgba(26, 22, 34, .55); backdrop-filter: blur(3px); }
  .book[open] { animation: book-in var(--dur) var(--ease); }
  @keyframes book-in { from { opacity: 0; transform: translateY(12px); } }

  .book__panel { position: relative; padding: clamp(24px, 4vw, 40px); }

  .book__close {
    position: absolute; top: 14px; right: 14px;
    display: grid; place-items: center; width: 40px; height: 40px;
    border: 0; border-radius: 50%; background: transparent; color: var(--ink-muted); cursor: pointer;
  }
  .book__close:hover { background: var(--amethyst-50); color: var(--amethyst-900); }

  .book__steps { display: flex; gap: var(--s-4); margin-bottom: var(--s-5); font-size: var(--fs-credential); color: var(--ink-muted); }
  .book__steps li { display: flex; align-items: center; gap: 8px; }
  .book__steps span {
    display: grid; place-items: center; width: 22px; height: 22px; border-radius: 6px;
    background: var(--paper-deep); font-weight: 500;
  }
  .book__steps li.is-active { color: var(--ink); font-weight: 500; }
  .book__steps li.is-active span { background: var(--amethyst-900); color: #fff; }

  .book__title { font-family: var(--font-display); font-size: var(--fs-display-md); font-weight: 400; letter-spacing: var(--ls-display); line-height: 1.1; }
  .book__title em { font-style: normal; color: var(--amethyst-600); }
  .book__sub { margin-top: var(--s-2); color: var(--ink-muted); font-size: var(--fs-body-sm); }

  .book__who-photo { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: 50% 15%; flex: 0 0 auto; }
  .book__who-text { display: flex; flex-direction: column; gap: 2px; }
  .book__who {
    display: flex; align-items: center; gap: var(--s-4);
    margin-block: var(--s-5); padding-block: var(--s-4);
    border-block: 1px solid var(--hairline); font-size: var(--fs-body-sm);
  }
  .book__who-label { color: var(--ink-muted); }
  .book__who strong { font-family: var(--font-display); font-size: 1.125rem; font-weight: 500; }

  .book__modes { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: var(--s-3); }
  .book__mode {
    display: flex; flex-direction: column; gap: 4px; padding: var(--s-4); text-align: left;
    border: 0; border-radius: var(--r-media); background: var(--surface); color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--hairline); cursor: pointer; font: inherit;
    transition: box-shadow var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .book__mode:hover { box-shadow: inset 0 0 0 1px var(--amethyst-600); }
  .book__mode[aria-checked="true"] { background: var(--amethyst-50); box-shadow: inset 0 0 0 2px var(--amethyst-900); }
  .book__mode-label { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 500; }
  .book__mode-where { font-size: var(--fs-body-sm); color: var(--ink-body); }
  .book__mode-hours { margin-top: 6px; font-size: var(--fs-credential); font-weight: 500; letter-spacing: .02em; color: var(--gilt-600); }

  .book__label { margin: var(--s-5) 0 var(--s-2); font-size: var(--fs-credential); font-weight: 500; letter-spacing: var(--ls-cred); text-transform: uppercase; color: var(--ink-muted); }
  .book__hint { font-size: var(--fs-body-sm); color: var(--ink-muted); }
  .book__hint[hidden] { display: none; }

  .book__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .book__chip {
    min-height: 40px; padding: 8px 14px; border: 0; border-radius: 10px; background: var(--surface);
    color: var(--ink); font: inherit; font-size: var(--fs-body-sm); cursor: pointer;
    box-shadow: inset 0 0 0 1px var(--hairline);
    transition: box-shadow var(--dur-fast) var(--ease), background var(--dur-fast) var(--ease);
  }
  .book__chip small { display: block; font-size: .6875rem; color: var(--ink-muted); }
  .book__chip:hover { box-shadow: inset 0 0 0 1px var(--amethyst-600); }
  .book__chip[aria-checked="true"] { background: var(--amethyst-900); color: #fff; box-shadow: none; }
  .book__chip[aria-checked="true"] small { color: rgba(255, 255, 255, .75); }

  .book__fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); margin-top: var(--s-2); }
  .book__field { display: flex; flex-direction: column; }
  .book__field input {
    min-height: 48px; padding: 0 14px; border: 0; border-radius: 10px; background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline); font: inherit; font-size: 1rem; color: var(--ink);
  }
  .book__field input:focus-visible { outline: 2px solid var(--amethyst-600); outline-offset: 1px; }
  .book__field input[aria-invalid="true"] { box-shadow: inset 0 0 0 1.5px #B3261E; }

  .book__needed { min-height: 1.4em; margin-top: var(--s-3); font-size: var(--fs-body-sm); color: var(--ink-muted); }
  .book__done-note { margin-top: var(--s-5); font-size: var(--fs-body-sm); color: var(--ink-body); line-height: 1.6; }

  .book__foot { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: var(--s-3); margin-top: var(--s-5); padding-top: var(--s-5); border-top: 1px solid var(--hairline); }
  .book__btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 26px;
    border: 0; border-radius: var(--r-pill); background: var(--amethyst-900); color: #fff;
    font: inherit; font-size: var(--fs-body-sm); font-weight: 500; text-decoration: none; cursor: pointer;
    transition: background var(--dur-fast) var(--ease);
  }
  .book__btn:hover:not(:disabled) { background: var(--amethyst-600); }
  .book__btn:disabled { opacity: .4; cursor: not-allowed; }
  .book__btn--ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--hairline); }
  .book__btn--ghost:hover:not(:disabled) { background: var(--amethyst-50); }

  .book__fine { margin-top: var(--s-4); text-align: center; font-size: var(--fs-credential); color: var(--ink-muted); }
  .book__fine a { color: var(--ink); font-weight: 500; }

  .book :focus-visible { outline: 2px solid var(--amethyst-600); outline-offset: 2px; }

  @media (max-width: 560px) {
    .book__fields { grid-template-columns: 1fr; }
    .book__foot > * { flex: 1 1 auto; }
  }
  @media (prefers-reduced-motion: reduce) { .book[open] { animation: none; } }
</style>

<script>
  type Mode = {
    id: 'in-person' | 'online';
    label: string;
    short: string;
    daysDisplay: string;
    hoursDisplay: string;
    days: number[];
    opens: string;
    closes: string;
  };
  type Config = {
    modes: Mode[];
    slot: number;
    windowDays: number;
    lead: number;
    tz: string;
    whatsapp: string;
    doctor: string;
  };

  const dialog = document.querySelector<HTMLDialogElement>('#book-dialog');

  if (dialog) {
    const cfg: Config = JSON.parse(dialog.dataset.config || '{}');
    const $ = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
    const steps = [...dialog.querySelectorAll<HTMLElement>('[data-step]')];
    const dots = [...dialog.querySelectorAll<HTMLElement>('[data-step-dot]')];
    const modeBtns = [...dialog.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    const nextBtn = $<HTMLButtonElement>('[data-next]');
    const confirmBtn = $<HTMLButtonElement>('[data-confirm]');
    const daysEl = $('[data-days]');
    const timesEl = $('[data-times]');
    const hintEl = $('[data-time-hint]');
    const summaryEl = $('[data-summary]');
    const neededEl = $('[data-needed]');
    const nameEl = $<HTMLInputElement>('input[name="name"]');
    const phoneEl = $<HTMLInputElement>('input[name="phone"]');
    const waLink = $<HTMLAnchorElement>('[data-wa-link]');
    const doneSummary = $('[data-done-summary]');

    let mode: Mode | null = null;
    let day: string | null = null; // YYYY-MM-DD, in the clinic's calendar
    let time: string | null = null; // HH:MM

    /* ---- clinic-time helpers ------------------------------------------- */

    // "Now" as seen on the clinic's wall clock, regardless of the device's zone.
    const clinicNow = () => {
      const parts = Object.fromEntries(
        new Intl.DateTimeFormat('en-GB', {
          timeZone: cfg.tz, year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', hourCycle: 'h23',
        }).formatToParts(new Date()).map((p) => [p.type, p.value]),
      );
      return {
        date: Date.UTC(+parts.year, +parts.month - 1, +parts.day),
        minutes: +parts.hour * 60 + +parts.minute,
      };
    };

    const iso = (ms: number) => new Date(ms).toISOString().slice(0, 10);
    const toMin = (t: string) => +t.slice(0, 2) * 60 + +t.slice(3, 5);
    const pad = (n: number) => String(n).padStart(2, '0');
    const fmtTime = (t: string) => {
      const h = +t.slice(0, 2);
      return `${h % 12 === 0 ? 12 : h % 12}:${t.slice(3, 5)} ${h < 12 ? 'am' : 'pm'}`;
    };
    const fmtDay = (d: string, opts: Intl.DateTimeFormatOptions) =>
      new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', ...opts }).format(new Date(`${d}T00:00:00Z`));

    const slotsFor = (m: Mode, d: string) => {
      const now = clinicNow();
      const out: string[] = [];
      for (let t = toMin(m.opens); t + cfg.slot <= toMin(m.closes); t += cfg.slot) {
        if (Date.parse(`${d}T00:00:00Z`) === now.date && t < now.minutes + cfg.lead) continue;
        out.push(`${pad(Math.floor(t / 60))}:${pad(t % 60)}`);
      }
      return out;
    };

    const daysFor = (m: Mode) => {
      const today = clinicNow().date;
      const out: string[] = [];
      for (let i = 0; i < cfg.windowDays; i++) {
        const ms = today + i * 86400000;
        const d = iso(ms);
        if (m.days.includes(new Date(ms).getUTCDay()) && slotsFor(m, d).length) out.push(d);
      }
      return out;
    };

    /* ---- rendering ----------------------------------------------------- */

    const show = (n: number) => {
      steps.forEach((s) => (s.hidden = s.dataset.step !== String(n)));
      dots.forEach((d) => d.classList.toggle('is-active', d.dataset.stepDot === String(Math.min(n, 2))));
    };

    const chip = (label: string, sub: string | null, onPick: () => void, selected: boolean) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'book__chip';
      b.setAttribute('role', 'radio');
      b.setAttribute('aria-checked', String(selected));
      b.textContent = label;
      if (sub) {
        const s = document.createElement('small');
        s.textContent = sub;
        b.append(s);
      }
      b.addEventListener('click', onPick);
      return b;
    };

    const renderDays = () => {
      daysEl.replaceChildren();
      if (!mode) return;
      const list = daysFor(mode);
      list.forEach((d) =>
        daysEl.append(
          chip(fmtDay(d, { day: 'numeric', month: 'short' }), fmtDay(d, { weekday: 'short' }), () => {
            day = d;
            time = null;
            renderDays();
            renderTimes();
            validate();
          }, d === day),
        ),
      );
      if (!list.length) daysEl.textContent = 'No open days in the next few weeks. Please message the clinic.';
    };

    const renderTimes = () => {
      timesEl.replaceChildren();
      hintEl.hidden = !!day;
      if (!mode || !day) return;
      const list = slotsFor(mode, day);
      list.forEach((t) =>
        timesEl.append(chip(fmtTime(t), null, () => { time = t; renderTimes(); validate(); }, t === time)),
      );
    };

    const validPhone = () => phoneEl.value.replace(/\D/g, '').length >= 10;
    const validName = () => nameEl.value.trim().length >= 2;

    const validate = () => {
      const missing: string[] = [];
      if (!day) missing.push('a day');
      if (!time) missing.push('a time');
      if (!validName()) missing.push('your name');
      if (!validPhone()) missing.push('your phone number');
      neededEl.textContent = missing.length ? `Still needed: ${missing.join(', ').replace(/, ([^,]*)$/, ' and $1')}.` : '';
      confirmBtn.disabled = missing.length > 0;
    };

    const setMode = (m: Mode) => {
      if (mode?.id !== m.id) { day = null; time = null; }
      mode = m;
      modeBtns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.mode === m.id)));
      nextBtn.disabled = false;
    };

    const message = () =>
      [
        `Assalam-o-Alaikum. I would like to book an appointment with ${cfg.doctor}.`,
        '',
        `Type: ${mode!.short}`,
        `Day: ${fmtDay(day!, { weekday: 'long', day: 'numeric', month: 'long' })}`,
        `Time: ${fmtTime(time!)} (Pakistan time)`,
        `Name: ${nameEl.value.trim()}`,
        `Phone: ${phoneEl.value.trim()}`,
      ].join('\n');

    /* ---- events -------------------------------------------------------- */

    const open = (preset?: string) => {
      const m = cfg.modes.find((x) => x.id === preset) || null;
      day = null; time = null;
      if (m) setMode(m);
      else { mode = null; modeBtns.forEach((b) => b.setAttribute('aria-checked', 'false')); nextBtn.disabled = true; }
      nameEl.value = ''; phoneEl.value = '';
      nameEl.removeAttribute('aria-invalid'); phoneEl.removeAttribute('aria-invalid');
      show(1);
      if (!dialog.open) dialog.showModal();
    };

    const goStep2 = () => {
      if (!mode) return;
      summaryEl.textContent = `Step 2 of 2. ${mode.short} · ${mode.daysDisplay}, ${mode.hoursDisplay}.`;
      renderDays(); renderTimes(); validate(); show(2);
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-book]');
      if (!trigger || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      open(trigger.dataset.book || undefined);
    });

    dialog.querySelectorAll('[data-book-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    // A click on the backdrop lands on the <dialog> itself, outside the panel.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    modeBtns.forEach((b) =>
      b.addEventListener('click', () => setMode(cfg.modes.find((m) => m.id === b.dataset.mode)!)),
    );
    nextBtn.addEventListener('click', goStep2);
    $('[data-back]').addEventListener('click', () => show(1));

    [nameEl, phoneEl].forEach((el) => el.addEventListener('input', () => { el.removeAttribute('aria-invalid'); validate(); }));
    nameEl.addEventListener('blur', () => { if (nameEl.value && !validName()) nameEl.setAttribute('aria-invalid', 'true'); });
    phoneEl.addEventListener('blur', () => { if (phoneEl.value && !validPhone()) phoneEl.setAttribute('aria-invalid', 'true'); });

    confirmBtn.addEventListener('click', () => {
      if (!mode || !day || !time || !validName() || !validPhone()) return;
      const url = `https://wa.me/${cfg.whatsapp}?text=${encodeURIComponent(message())}`;
      waLink.href = url;
      doneSummary.textContent =
        `${mode.short} · ${fmtDay(day, { weekday: 'long', day: 'numeric', month: 'long' })} at ${fmtTime(time)}.`;
      show(3);
      window.open(url, '_blank', 'noopener');
    });
  }
</script>
