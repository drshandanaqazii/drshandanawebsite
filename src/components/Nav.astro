---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { NAV_LINKS, DOCTOR, PRACTICE } from '../consts';
---

<header class="navwrap">
  <div class="container">
    <nav class="nav" aria-label="Main">
      <ul class="nav__links">
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>

      <a class="nav__mark" href="#top" aria-label={`${DOCTOR.name}, home`}>
        <svg class="nav__arch" viewBox="0 0 26 17" fill="none" aria-hidden="true">
          <path d="M1 16a12 12 0 0 1 24 0" stroke="var(--amethyst-900)" stroke-width="1.5" />
          <path d="M8 16a5 5 0 0 1 10 0" stroke="var(--amethyst-600)" stroke-width="1.5" />
        </svg>
        <span class="nav__word">Dr. Shandana Qazi</span>
      </a>

      <div class="nav__actions">
        <a class="nav__tel" href={`tel:${PRACTICE.bookingPhone.replace(/\s/g, '')}`}>
          <Icon name="phone" size="sm" />
          <span>{PRACTICE.bookingPhoneDisplay}</span>
        </a>
        <Button href="#contact" class="nav__cta">Book a consultation</Button>
        <button
          class="nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <Icon name="menu" />
        </button>
      </div>
    </nav>

    {/* The phone number lives only here. On a phone, tapping to call is the
        shortest path to a booking; on desktop it is an un-clickable string
        competing with the CTA, so the bar carries the CTA alone. */}
    <div class="nav__mobile" id="mobile-menu" hidden>
      <ul>
        {NAV_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a class="nav__mobile-cta" href="#contact">Book a consultation</a></li>
        <li>
          <a class="nav__mobile-tel" href={`tel:${PRACTICE.bookingPhone.replace(/\s/g, '')}`}>
            <Icon name="phone" size="sm" />
            <span>{PRACTICE.bookingPhoneDisplay}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .navwrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: var(--s-4);
    padding-bottom: var(--s-2);
  }

  .nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-5);
    min-height: 64px;
    padding: 8px 8px 8px var(--s-5);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--shadow-nav);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-body-sm);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__links a:hover { color: var(--amethyst-600); }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__arch { width: 20px; height: 13px; }
  /* The wordmark has no serif left to set it apart from the links beside it,
     so it takes weight and size instead. */
  .nav__word {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -.02em;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-4);
  }

  .nav__tel {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    font-size: var(--fs-body-sm);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__tel:hover { color: var(--amethyst-600); }

  .nav__toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--amethyst-900);
    color: #fff;
    cursor: pointer;
  }

  .nav__mobile {
    margin-top: var(--s-2);
    padding: var(--s-4) var(--s-5) var(--s-5);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--hairline), var(--shadow-nav);
  }
  .nav__mobile ul { display: flex; flex-direction: column; }
  .nav__mobile a {
    display: block;
    padding-block: 14px;
    border-bottom: 1px solid var(--hairline);
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
  }
  .nav__mobile .nav__mobile-cta { color: var(--amethyst-600); }

  /* Outranks the `.nav__mobile a` block above, which is a class+element. */
  .nav__mobile .nav__mobile-tel {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    border-bottom: 0;
    font-weight: 500;
  }
  .nav__mobile .nav__mobile-tel :global(.icon) { flex: 0 0 auto; color: var(--ink-muted); }

  /* Below 1040px the link list and phone number don't fit alongside the CTA.
     The number is not lost — it reappears inside the open mobile menu. */
  @media (max-width: 1040px) {
    .nav__links, .nav__tel { display: none; }
    .nav { grid-template-columns: auto 1fr auto; }
    .nav__mark { justify-self: start; }
    .nav__toggle { display: grid; }
  }

  @media (max-width: 620px) {
    .nav :global(.nav__cta) { display: none; }
    .nav__word { font-size: 1.05rem; }
  }

  @media (min-width: 1041px) {
    .nav__mobile { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    setOpen(false);

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    // closest(), not tagName: the phone link wraps an icon and a span, so a tap
    // usually lands on a child rather than the anchor itself.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
