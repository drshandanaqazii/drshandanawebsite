---
import Icon from './Icon.astro';
import Button from './Button.astro';
import { NAV_LINKS, DOCTOR, SALMA } from '../consts';
import { WHATSAPP_HREF } from '../lib/practice-links';

/* Trailing slash stripped so "/about/" and "/about" both mark the same link.
   A service page keeps /services lit, which is what a visitor two levels
   down expects to see. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="navwrap">
  <div class="container">
    <nav class="nav" aria-label="Main">
      <ul class="nav__links">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class={isCurrent(link.href) ? 'is-current' : undefined}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
      </ul>

      <a class="nav__mark" href="/" aria-label={`${DOCTOR.name}, home`}>
        <svg class="nav__arch" viewBox="0 0 26 17" fill="none" aria-hidden="true">
          <path d="M1 16a12 12 0 0 1 24 0" stroke="var(--amethyst-900)" stroke-width="1.5" />
          <path d="M8 16a5 5 0 0 1 10 0" stroke="var(--amethyst-600)" stroke-width="1.5" />
        </svg>
        <span class="nav__word">Dr. Shandana Qazi</span>
      </a>

      <div class="nav__actions">
        <a class="nav__tel" href={WHATSAPP_HREF} rel="noopener noreferrer" target="_blank">
          <Icon name="whatsapp" size="sm" />
          <span>{SALMA.whatsappDisplay}</span>
        </a>
        <Button href="/appointments" class="nav__cta">Book a consultation</Button>
        <button
          class="nav__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <Icon name="menu" />
        </button>
      </div>
    </nav>

    {/* Appointment enquiries go to the clinic's WhatsApp. */}
    <div class="nav__mobile" id="mobile-menu" hidden>
      <ul>
        {NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li><a class="nav__mobile-cta" href="/appointments">Book a consultation</a></li>
        {/* WhatsApp opens directly to the clinic's appointment chat. */}
        <li class="nav__mobile-reach">
          <a
            class="nav__mobile-tel"
            href={WHATSAPP_HREF}
            rel="noopener noreferrer"
            target="_blank"
          >
            <Icon name="whatsapp" size="sm" />
            <span>WhatsApp · {SALMA.whatsappDisplay}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<style>
  .navwrap {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: var(--s-4);
    padding-bottom: var(--s-2);
  }

  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s-5);
    min-height: 64px;
    padding: 8px 8px 8px var(--s-5);
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: var(--shadow-nav);
  }

  .nav__links {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-5);
  }
  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-body-sm);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav__links a:hover { color: var(--amethyst-600); }

  /* The current page is marked by an underline rather than by colour: amethyst
     already means "hover" in this bar, and a link that is permanently in the
     hover state reads as stuck rather than as current. */
  .nav__links a.is-current {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--amethyst-600);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 6px;
  }

  .nav__mark {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__arch { width: 20px; height: 13px; }
  /* The wordmark has no serif left to set it apart from the links beside it,
     so it takes weight and size instead. */
  .nav__word {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -.02em;
  }

  .nav__actions {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-4);
  }

  .nav__tel {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    font-size: var(--fs-body-sm);
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav__tel:hover { color: var(--amethyst-600); }

  .nav__toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--amethyst-900);
    color: #fff;
    cursor: pointer;
  }

  /* The open panel is the only navigation on a phone, so it carries the brand
     rather than reading as a plain list: a tinted ground, amethyst hairlines,
     and the CTA as a filled pill instead of a coloured line of text. */
  .nav__mobile {
    margin-top: var(--s-2);
    padding: var(--s-4) var(--s-5) var(--s-5);
    border-radius: var(--r-card);
    background: linear-gradient(180deg, var(--surface) 0%, var(--amethyst-50) 100%);
    box-shadow: inset 0 0 0 1px var(--amethyst-100), var(--shadow-nav);
  }
  .nav__mobile ul { display: flex; flex-direction: column; }
  .nav__mobile a {
    display: block;
    padding-block: 14px;
    border-bottom: 1px solid var(--amethyst-100);
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
  }

  /* A dot rather than a colour swap, so the current page is legible against
     the amethyst the panel already uses for the CTA. */
  .nav__mobile a[aria-current='page'] {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--amethyst-900);
    font-weight: 500;
  }
  .nav__mobile a[aria-current='page']::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amethyst-600);
  }

  .nav__mobile .nav__mobile-cta {
    margin-top: var(--s-4);
    padding: 14px var(--s-4);
    border-bottom: 0;
    border-radius: var(--r-pill);
    background: var(--amethyst-900);
    color: #fff;
    font-weight: 500;
    text-align: center;
  }

  /* The two reach-the-desk links share a row and split it evenly. The <li> is
     the flex container rather than the <ul>, so the pair stays one item in the
     list for anything reading the menu aloud. */
  .nav__mobile-reach {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-4);
  }

  /* Outranks the `.nav__mobile a` block above, which is a class+element. */
  .nav__mobile .nav__mobile-tel {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-2);
    /* Tapped, not read: both are now targets sitting side by side, so each gets
       an outline and a 48px box of its own rather than being a line of coloured
       text with nothing to aim at. */
    min-height: 48px;
    padding-block: 0;
    border-radius: var(--r-pill);
    border-bottom: 0;
    box-shadow: inset 0 0 0 1px var(--amethyst-100);
    color: var(--amethyst-900);
    font-weight: 500;
    font-size: var(--fs-body-sm);
  }
  .nav__mobile .nav__mobile-tel:hover { background: var(--surface); }
  .nav__mobile .nav__mobile-tel :global(.icon) { flex: 0 0 auto; color: var(--amethyst-600); }

  /* Below this the link list and phone number don't fit alongside the CTA. The
     number is not lost — it reappears inside the open mobile menu.

     Raised from 1040px when the sixth link went in. Six labels plus the wordmark
     plus the number plus the pill is about 1100px of content, and at 1040 the
     bar was overflowing its own container rather than collapsing — the links
     ran under the wordmark. If a seventh tab is ever added, measure this again
     rather than assuming it still clears. */
  @media (max-width: 1140px) {
    .nav__links, .nav__tel { display: none; }
    .nav { grid-template-columns: auto 1fr auto; }
    .nav__mark { justify-self: start; }
    .nav__toggle { display: grid; }
  }

  @media (max-width: 620px) {
    .nav :global(.nav__cta) { display: none; }
    .nav__word { font-size: 1.05rem; }
  }

  @media (min-width: 1141px) {
    .nav__mobile { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    setOpen(false);

    // Coerced: `hidden` is typed `boolean | "until-found"`, so it is not
    // assignable to a boolean parameter without this.
    toggle.addEventListener('click', () => {
      setOpen(!!menu.hidden);
    });

    // closest(), not tagName: the phone link wraps an icon and a span, so a tap
    // usually lands on a child rather than the anchor itself.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
