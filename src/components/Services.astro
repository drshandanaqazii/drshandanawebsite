---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { FEATURED_SERVICES } from '../consts';
import { SERVICE_IMAGES, DEFAULT_PAN } from '../lib/service-images';
---

<section class="section" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="container-narrow statement" style="padding-inline: 0;" data-reveal-group data-parallax="-26">
      <p class="eyebrow" data-reveal>Services</p>
      <h2 class="display-lg" id="services-heading" data-reveal>
        What she <em>treats</em>.
      </h2>
      {/* The three conditions without a card are named here rather than left
          out: someone searching for any of them should still find them on the
          homepage, and a seventh card would break the two rows of three. Each
          is a link, so the sentence is also the route to those pages. */}
      <p class="prose" style="margin-top: var(--s-2);" data-reveal>
        Adolescent and adult psychiatry, with particular attention to female mental health.
        <a href="/services/ocd">Obsessive–compulsive disorder</a>,
        <a href="/services/psychosis">psychotic disorders</a> and
        <a href="/services/adolescent-mental-health">adolescent mental health</a> are
        treated too. If what you are dealing with is not below, it is still worth asking.
      </p>
    </div>

    {/* Cards rise a little as a group; each photograph pans further inside its
        own frame. Two rates over the same distance is what gives the grid
        depth — one rate would just be a moving grid. */}
    <ul class="cards" data-reveal-group data-parallax="-16">
      {FEATURED_SERVICES.map((service) => {
        const image = SERVICE_IMAGES[service.image];
        return (
        <li class="card" data-reveal>
          <figure class="card__media parallax-frame">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[380, 620]}
              sizes="(max-width: 900px) 92vw, 33vw"
              loading="lazy"
              data-parallax={String(image.pan ?? DEFAULT_PAN)}
              data-parallax-scale="1.22"
              style={[
                image.position && `object-position: ${image.position}`,
                image.origin && `--parallax-origin: ${image.origin}`,
              ].filter(Boolean).join('; ')}
            />
          </figure>
          <span class="card__icon"><Icon name={service.icon} /></span>
          <h3 class="card-title">
            {/* The whole card is the target, not just these words — see the
                stretched-link rule below. */}
            <a class="card__link" href={`/services/${service.slug}`}>
              {service.card.title} <em>{service.card.titleEm}</em>
            </a>
          </h3>
          <p class="body-sm">{service.card.body}</p>
          <p class="card__more" aria-hidden="true">
            Read more <Icon name="arrow" size="sm" />
          </p>
        </li>
        );
      })}
    </ul>

    <div class="services__all" data-reveal>
      <Button href="/services" variant="ghost">See all services</Button>
    </div>
  </div>
</section>

<style>
  /* Two rows of three. The stagger in motion.ts runs across all six in one
     pass, which is what keeps the second row from arriving as a separate
     event. */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-5);
    margin-top: clamp(48px, 6vw, 72px);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5);
    background: var(--surface);
    border-radius: var(--r-card);
    box-shadow: inset 0 0 0 1px var(--hairline), var(--shadow-card);
  }

  .card__media {
    border-radius: var(--r-media);
    overflow: hidden;
    margin-bottom: var(--s-2);
  }
  .card__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--amethyst-50);
    color: var(--amethyst-900);
  }

  /* One link per card, stretched over the whole surface. The alternative — a
     second "read more" anchor beside the title — gives a screen reader two
     links to the same page and gives a mouse two targets that look like one.
     The visible cue below is therefore text, not an anchor. */
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  /* The radius is named rather than inherited — ::after inherits from the <a>,
     which has none of its own, and the corners of the card should not be
     clickable outside the card. */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-card);
  }
  .card:hover .card__link { color: var(--amethyst-900); }

  .card__more {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: var(--s-3);
    color: var(--ink-muted);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease);
  }
  .card:hover .card__more { color: var(--amethyst-600); }
  .card__more :global(.icon) {
    transition: transform var(--dur-fast) var(--ease);
  }
  .card:hover .card__more :global(.icon) { transform: translateX(3px); }

  .services__all {
    display: flex;
    justify-content: center;
    margin-top: clamp(40px, 5vw, 56px);
  }

  /* Two columns before one: six cards in a single column is a very long
     scroll, and the card is still legible at half a tablet's width. */
  @media (max-width: 1000px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__more :global(.icon) { transform: none; }
  }
</style>
