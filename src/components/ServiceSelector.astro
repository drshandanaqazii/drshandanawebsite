---
/**
 * The services selector — the full list, and one card.
 *
 * Choosing a name on the left swaps the card on the right; the chosen name is
 * solid and the rest are faded back, so the list reads as a set of options
 * rather than nine equal headings competing for the eye.
 *
 * The panel for each service is a child of its own list item rather than a
 * sibling in a separate column. That single decision is what lets the same
 * markup be two layouts: on a wide screen each panel is lifted out of flow and
 * placed in the reserved right-hand column, where they stack on top of each
 * other and only the open one is painted; on a narrow screen the same panel
 * simply stays in flow and opens directly underneath the name that was tapped.
 * An accordion and a two-column selector from one DOM, and nothing is rendered
 * twice for the sake of a breakpoint.
 *
 * Every panel, open or not, is real markup with a real link in it, so all nine
 * service pages are reachable whether or not the script runs.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { SERVICE_IMAGES } from '../lib/service-images';
import type { Service } from '../data/services';

interface Props {
  items: readonly Service[];
}

const { items } = Astro.props;
---

{/* The list reveals as one block rather than staggering its rows, and the
    reason is structural: .is-in leaves a permanent translate3d on whatever it
    reveals, and a transformed <li> would become the containing block for its
    own absolutely-positioned panel — nine cards anchored to nine different rows
    instead of one column. The transform belongs on .svc__list, which is the
    containing block the panels actually want. */}
<div class="svc" data-services data-parallax="-16">
  <ul class="svc__list" data-reveal>
    {items.map((service, i) => {
      const image = SERVICE_IMAGES[service.image];
      const panelId = `svc-panel-${service.slug}`;
      return (
        <li class="svc__item" data-svc-item data-open={i === 0 ? '' : undefined}>
          <h3 class="svc__heading">
            <button
              type="button"
              class="svc__name"
              id={`svc-tab-${service.slug}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={panelId}
              data-svc-name
            >
              <span class="svc__arrow" aria-hidden="true"><Icon name="arrow" size="sm" /></span>
              <span class="svc__label">{service.label}</span>
            </button>
          </h3>

          <div class="svc__panel" id={panelId} role="region" aria-labelledby={`svc-tab-${service.slug}`} data-svc-panel>
            <figure class="svc__media">
              <Image
                src={image.src}
                alt={image.alt}
                widths={[520, 820]}
                sizes="(max-width: 900px) 92vw, 48vw"
                loading="lazy"
                style={image.position ? `object-position: ${image.position}` : undefined}
              />
            </figure>

            {/* The readable plate. It sits on the photograph rather than under
                it so the card stays one object — a caption below the image
                would split it into two. */}
            <div class="svc__plate">
              <p class="svc__title">
                {service.card.title} <em>{service.card.titleEm}</em>
              </p>
              <p class="svc__body">{service.card.body}</p>
              <a class="svc__cta" href={`/services/${service.slug}`}>
                <span>View details</span>
                <span class="svc__cta-icon" aria-hidden="true"><Icon name="arrow" size="sm" /></span>
                <span class="visually-hidden">about {service.label.toLowerCase()}</span>
              </a>
            </div>
          </div>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .svc {
    /* The card's height is set here and read by both the panel and the list's
       min-height, so the right column can never be taller than the space the
       left column has reserved for it. */
    --svc-card-h: clamp(420px, 40vw, 560px);
    --svc-gap: clamp(32px, 4vw, 64px);
    --svc-col: 48%;
  }

  /* Every panel is positioned against this, so it must stay the nearest
     positioned ancestor — nothing between here and .svc__panel may take a
     position or a transform of its own. */
  .svc__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- the name ---------------------------------------------------------- */

  .svc__heading {
    margin: 0;
    font: inherit;
  }

  .svc__name {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.3vw, 2rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -.02em;
    text-align: left;
    /* Faded, not greyed: the same ink as the page, thinned. A separate grey
       would read as a second colour on a page that only has one. */
    color: rgba(26, 22, 34, .26);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease);
  }

  .svc__label {
    position: relative;
    padding-block: 2px;
  }

  /* The rule under the open name is drawn on the label rather than the button
     so it stops at the word, not at the end of the column. */
  .svc__label::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--amethyst-600);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .svc__arrow {
    display: grid;
    place-items: center;
    color: var(--amethyst-600);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
  }

  .svc__name:hover { color: rgba(26, 22, 34, .5); }
  .svc__name:focus-visible {
    outline: 2px solid var(--amethyst-600);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .svc__item[data-open] .svc__name { color: var(--ink); }
  .svc__item[data-open] .svc__label::after { transform: scaleX(1); }
  .svc__item[data-open] .svc__arrow { opacity: 1; transform: none; }

  /* --- the card ---------------------------------------------------------- */

  .svc__panel {
    position: relative;
    border-radius: var(--r-card);
    overflow: hidden;
    background: var(--amethyst-900);
    box-shadow: var(--shadow-card);
    isolation: isolate;
  }

  .svc__media {
    margin: 0;
    height: 100%;
  }
  .svc__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Darkens the lower half so the plate has something to sit on whatever the
     photograph happens to be doing behind it. */
  .svc__panel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(26, 22, 34, 0) 35%, rgba(26, 22, 34, .55) 100%);
    pointer-events: none;
  }

  .svc__plate {
    position: absolute;
    z-index: 1;
    left: clamp(12px, 2.5%, 20px);
    right: clamp(12px, 2.5%, 20px);
    bottom: clamp(12px, 2.5%, 20px);
    padding: clamp(16px, 2.2vw, 22px);
    border-radius: var(--r-media);
    background: rgba(32, 25, 48, .58);
    border: 1px solid rgba(255, 255, 255, .16);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    color: var(--ink-on-dark);
  }

  /* No backdrop-filter, no translucency — an unreadable plate is worse than an
     opaque one. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .svc__plate { background: rgba(32, 25, 48, .9); }
  }

  .svc__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-card-title);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    color: #fff;
  }
  .svc__title em {
    font-style: normal;
    color: var(--amethyst-100);
  }

  .svc__body {
    margin: var(--s-2) 0 0;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: rgba(243, 240, 248, .82);
  }

  .svc__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: var(--s-4);
    padding: 10px 10px 10px 18px;
    border-radius: var(--r-pill);
    background: #fff;
    color: var(--ink);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .svc__cta-icon {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--amethyst-900);
    color: #fff;
    transition: transform var(--dur-fast) var(--ease);
  }
  .svc__cta:hover { background: var(--amethyst-100); }
  .svc__cta:hover .svc__cta-icon { transform: translateX(2px); }
  .svc__cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* --------------------------------------------------------------------------
     Wide: the panels leave the flow and stack in the reserved right column.
     -------------------------------------------------------------------------- */
  @media (min-width: 901px) {
    .svc__list {
      /* The right column is reserved as padding, so the nine names lay
         themselves out in what is left and the absolute panels have somewhere
         to land without either column knowing about the other. */
      padding-right: calc(var(--svc-col) + var(--svc-gap));
      min-height: var(--svc-card-h);
    }

    .svc__item + .svc__item { margin-top: clamp(10px, 1vw, 18px); }

    .svc__name { width: auto; }

    .svc__panel {
      position: absolute;
      top: 0;
      right: 0;
      width: var(--svc-col);
      height: var(--svc-card-h);
      opacity: 0;
      visibility: hidden;
      transform: scale(.985);
      transition:
        opacity var(--dur) var(--ease),
        transform var(--dur) var(--ease),
        visibility 0s linear var(--dur);
    }

    .svc__item[data-open] .svc__panel {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    /* Before the script runs there is no [data-open] on anything, so the first
       panel is shown on its own. Without this the column is empty until JS
       lands, and with JS off it stays empty forever. */
    .svc:not([data-ready]) .svc__item:first-child .svc__panel {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  /* --------------------------------------------------------------------------
     Narrow: the same panel, left in flow, opening under its own name.
     -------------------------------------------------------------------------- */
  @media (max-width: 900px) {
    .svc__item {
      border-bottom: 1px solid var(--hairline);
    }
    .svc__item:first-child { border-top: 1px solid var(--hairline); }

    .svc__name {
      justify-content: flex-start;
      /* A 56px-plus row rather than the height of the words: this is the tap
         target, and on a phone it is the only one. */
      padding-block: clamp(14px, 3.5vw, 18px);
      font-size: clamp(1.25rem, 5.2vw, 1.5rem);
    }

    /* The arrow turns down rather than sliding in, so opening an item does not
       shift the word it belongs to sideways. */
    .svc__arrow {
      opacity: 0;
      transform: rotate(90deg);
      transition: opacity var(--dur-fast) var(--ease), transform var(--dur) var(--ease);
    }
    .svc__item[data-open] .svc__arrow { opacity: 1; transform: rotate(90deg); }

    .svc__label::after { display: none; }

    /* Nothing collapses on a phone. Every card is in flow at full height and
       the scroll position decides which one is the current one — a tap is an
       optional shortcut, not the only way through the list. Because no panel
       ever changes height, the page can never shuffle under the thumb. */
    .svc__panel {
      height: clamp(340px, 78vw, 460px);
      margin-bottom: var(--s-5);
      opacity: .55;
      transform: scale(.955);
      transition:
        opacity var(--dur) var(--ease),
        transform var(--dur) var(--ease);
      will-change: transform;
    }

    .svc__item[data-open] .svc__panel {
      opacity: 1;
      transform: none;
    }

    /* The card in view holds still while its photograph drifts against the
       scroll — the only thing that moves is the image inside the frame, so the
       parallax costs no layout. The over-scale is the room that drift needs. */
    .svc__media :global(img) {
      transform: translate3d(0, var(--svc-shift, 0px), 0) scale(1.14);
      will-change: transform;
    }

    /* The plate is the readable part; it must not ride the image. */
    .svc__plate { transform: none; }

    /* With JS off there is no [data-open] and no shift — every card simply
       sits there at full strength, which is the correct resting state. */
    .svc:not([data-ready]) .svc__panel {
      opacity: 1;
      transform: none;
    }
    .svc:not([data-ready]) .svc__media :global(img) { transform: scale(1.14); }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc__panel,
    .svc__arrow,
    .svc__label::after,
    .svc__cta-icon {
      transition-duration: 1ms !important;
    }
    .svc__panel { transform: none !important; }
    /* No drift, and no dimming either: with motion off the "current" card can
       only be told apart by something that is not motion, so every card is
       simply shown at full strength. */
    .svc__media :global(img) { transform: scale(1.14) !important; }
    @media (max-width: 900px) {
      .svc__panel { opacity: 1 !important; }
    }
  }
</style>

<script>
  /**
   * Opens one service at a time.
   *
   * The markup is already correct before this runs — first item open, the rest
   * closed — so all this adds is the ability to change which one. Setting
   * data-ready on the container is what hands the CSS over from its static
   * fallback to the interactive rules.
   */
  function initServices(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-svc-item]'));
    if (!items.length) return;

    const buttons = items.map((item) => item.querySelector<HTMLButtonElement>('[data-svc-name]'));

    const open = (index: number) => {
      items.forEach((item, i) => {
        const isOpen = i === index;
        item.toggleAttribute('data-open', isOpen);
        buttons[i]?.setAttribute('aria-expanded', String(isOpen));
      });
    };

    // Whatever the markup shipped with stays open; this only establishes the
    // starting index for the keyboard handler.
    let current = Math.max(0, items.findIndex((item) => item.hasAttribute('data-open')));
    open(current);
    root.setAttribute('data-ready', '');

    buttons.forEach((button, i) => {
      if (!button) return;

      button.addEventListener('click', () => {
        current = i;
        open(i);
      });

      // On a pointer that can hover, moving across the list previews as it
      // goes — the list is a set of options, and reading it should feel like
      // one. Touch never fires this, so a tap is still the only way to open.
      button.addEventListener('pointerenter', (event) => {
        if ((event as PointerEvent).pointerType !== 'mouse') return;
        if (!matchMedia('(min-width: 901px) and (hover: hover)').matches) return;
        current = i;
        open(i);
      });

      button.addEventListener('keydown', (event) => {
        const keys = ['ArrowDown', 'ArrowUp', 'Home', 'End'];
        if (!keys.includes(event.key)) return;
        event.preventDefault();

        const next =
          event.key === 'Home' ? 0
          : event.key === 'End' ? items.length - 1
          : event.key === 'ArrowDown' ? (i + 1) % items.length
          : (i - 1 + items.length) % items.length;

        current = next;
        open(next);
        buttons[next]?.focus();
      });
    });

    /* ----------------------------------------------------------------------
       Phone: the scroll chooses.
       ----------------------------------------------------------------------
       Nothing here opens or closes anything — on a narrow screen every card is
       already laid out at full height. All this does is name the card the
       reader is currently in front of, and drift each photograph against the
       scroll while its card crosses the viewport. Both are pure paint: no
       measurement written back to the DOM changes a single height, so the
       list cannot shift under a thumb that is mid-swipe.

       Desktop never enters any of this — the media query is checked before a
       listener is attached and again on every frame. */
    const narrow = matchMedia('(max-width: 900px)');
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    const panels = items.map((item) => item.querySelector<HTMLElement>('[data-svc-panel]'));

    /** How far a photograph may travel inside its frame, in px each way. The
     *  1.14 over-scale in the stylesheet is what pays for it. */
    const DRIFT = 26;

    let frame = 0;

    const sample = () => {
      frame = 0;
      if (!narrow.matches) return;

      const viewport = window.innerHeight;
      // The line a card has to cross to become the current one. Above centre,
      // because a card reads as "arrived" a little before it is halfway up.
      const line = viewport * 0.46;
      let best = -1;
      let bestDistance = Infinity;

      items.forEach((item, i) => {
        const panel = panels[i];
        if (!panel) return;

        const box = panel.getBoundingClientRect();
        const centre = box.top + box.height / 2;

        if (!still.matches) {
          // -1 entering from the bottom, +1 leaving past the top.
          const progress = Math.max(-1, Math.min(1, (viewport / 2 - centre) / (viewport / 2 + box.height / 2)));
          panel.style.setProperty('--svc-shift', `${(progress * DRIFT).toFixed(2)}px`);
        } else {
          panel.style.removeProperty('--svc-shift');
        }

        // Only a card actually on screen may claim the list.
        if (box.bottom <= 0 || box.top >= viewport) return;
        const distance = Math.abs(centre - line);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });

      if (best !== -1 && best !== current) {
        current = best;
        open(best);
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(sample);
    };

    // Leaving the phone layout hands the list back to the click/hover model,
    // so the drift each panel was carrying has to be cleared or it would stay
    // baked into the desktop card.
    const reset = () => {
      if (narrow.matches) return schedule();
      panels.forEach((panel) => panel?.style.removeProperty('--svc-shift'));
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', reset, { passive: true });
    narrow.addEventListener('change', reset);
    still.addEventListener('change', reset);
    schedule();
  }

  document.querySelectorAll<HTMLElement>('[data-services]').forEach(initServices);
</script>
