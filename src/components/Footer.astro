---
import { NAV_LINKS, PRACTICE, DOCTOR } from '../consts';

const year = new Date().getFullYear();
---

{/* Pinned to the bottom of the viewport, behind the page. The content above
    scrolls away over it, so the footer is uncovered rather than scrolled to —
    it travels at zero while the page travels at one, which is the widest
    parallax spread on the site and the reason it works as the last beat. */}
<footer class="footer">
  <div class="container footer__inner">
    <svg class="footer__mark" viewBox="0 0 26 17" fill="none" aria-hidden="true">
      <path d="M1 16a12 12 0 0 1 24 0" stroke="#FFFFFF" stroke-width="1.25" />
      <path d="M6 16a7 7 0 0 1 14 0" stroke="rgba(255,255,255,.62)" stroke-width="1.25" />
      <path d="M10.5 16a2.5 2.5 0 0 1 5 0" stroke="rgba(255,255,255,.38)" stroke-width="1.25" />
    </svg>

    <p class="footer__name">{DOCTOR.name}</p>

    {/* Two chunks in a centred row, not a string joined by a middot: joined,
        it broke after the separator and left the dot hanging at the end of a
        line. As flex items they wrap as whole phrases instead. */}
    <p class="footer__role">
      <span>{DOCTOR.qualifications}</span>
      <span>{DOCTOR.jobTitle}</span>
    </p>

    {/* One horizontal row rather than a stacked list. Centred, a five-item
        ladder is what made the old footer read as a pile — across one line it
        reads as navigation. */}
    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {NAV_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        <li><a href="#contact">Booking</a></li>
      </ul>
    </nav>

    <p class="footer__contact">
      <a href={`tel:${PRACTICE.bookingPhone}`}>{PRACTICE.bookingPhoneDisplay}</a>
      <a href={`mailto:${PRACTICE.email}`}>{PRACTICE.email}</a>
    </p>

    <address class="footer__address">
      {PRACTICE.address.street}, {PRACTICE.address.locality},
      {' '}{PRACTICE.address.region}, Pakistan
    </address>

    <p class="footer__legal">
      &copy; {year} {DOCTOR.name}. All rights reserved. Information on this site is general
      and does not replace an individual consultation.
    </p>
  </div>
</footer>

<style>
  /* Top corners only. The footer runs to the bottom of the viewport, so
     rounding the lower pair would just cut two notches of paper out of the
     window edge; curving the top is what makes it read as a panel the page
     rests on rather than a bar stuck to the end of it. */
  .footer {
    /* The deepest amethyst, not the mid one: on a white page this block is the
       only large area of colour, and it has to land as an anchor rather than as
       a purple panel. */
    background: var(--amethyst-900);
    color: #FFFFFF;
    /* Far tighter than a normal section's rhythm. As a curtain the footer's
       height is also the gap the page has to scroll past, so generous padding
       here reads as an empty screen rather than as breathing room. */
    padding-block: clamp(40px, 4.5vw, 60px);
    border-radius: clamp(24px, 3.5vw, 44px) clamp(24px, 3.5vw, 44px) 0 0;
  }

  /* The curtain. Fixed and behind the page, so the last section slides off it
     instead of pushing it down. `main` reserves the height with its own
     margin — see the .curtain rules in global.css. */
  @media (min-height: 620px) {
    .footer {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 0;
    }
  }

  /* Centred, but on a measured rhythm rather than one flat gap: the identity
     block, the two link rows and the legal line are three groups, and the space
     between them is what separates them — not a rule between each. */
  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .footer__mark { width: 32px; height: 21px; }

  .footer__name {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.02em;
    color: #FFFFFF;
  }

  /* Every text tone down here is a solid colour, not white at an opacity.
     Stacked alphas on a purple ground were what made the old footer read as
     washed out; these are picked to clear 7:1 on --amethyst-900. */
  .footer__role {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: var(--s-4);
    margin-top: 6px;
    font-size: var(--fs-body-sm);
    color: #CFC7DE;
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--s-6);
    margin-top: var(--s-5);
  }
  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #FFFFFF;
    text-decoration: none;
    font-size: var(--fs-body-sm);
    transition: color var(--dur-fast) var(--ease);
  }

  .footer__contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px var(--s-5);
    font-size: var(--fs-body-sm);
  }
  .footer__contact a {
    color: #E7E2F2;
    text-decoration: none;
    word-break: break-word;
  }

  .footer__nav a:hover,
  .footer__contact a:hover {
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__address {
    margin-top: var(--s-3);
    font-style: normal;
    font-size: var(--fs-body-sm);
    line-height: 1.7;
    color: #CFC7DE;
    max-width: 48ch;
  }

  /* The one rule in the footer, and it only has to separate the legal line —
     the groups above are already separated by space. */
  .footer__legal {
    width: 100%;
    max-width: 72ch;
    margin-top: clamp(28px, 3.5vw, 40px);
    padding-top: var(--s-5);
    border-top: 1px solid rgba(255, 255, 255, .18);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #BEB4D2;
    text-wrap: pretty;
  }
</style>
