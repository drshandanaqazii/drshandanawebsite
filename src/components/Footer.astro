---
import Icon from './Icon.astro';
import { FOOTER_NAV, LEGAL_LINKS, PRACTICE, DOCTOR } from '../consts';

const year = new Date().getFullYear();
const telHref = `tel:${PRACTICE.bookingPhone.replace(/\s/g, '')}`;
---

{/* Pinned to the bottom of the viewport, behind the page — but only when it
    fits. src/scripts/motion.ts measures the footer against the window and sets
    data-curtain on <html>; on a narrow screen, where these four columns stack
    into a tall block, the flag is never set and the footer is simply scrolled
    to like any other element. See the note in global.css. */}
<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__identity">
        <svg class="footer__mark" viewBox="0 0 26 17" fill="none" aria-hidden="true">
          <path d="M1 16a12 12 0 0 1 24 0" stroke="#FFFFFF" stroke-width="1.25" />
          <path d="M6 16a7 7 0 0 1 14 0" stroke="rgba(255,255,255,.62)" stroke-width="1.25" />
          <path d="M10.5 16a2.5 2.5 0 0 1 5 0" stroke="rgba(255,255,255,.38)" stroke-width="1.25" />
        </svg>

        <p class="footer__name">{DOCTOR.name}</p>

        {/* Two chunks in a row, not a string joined by a middot: joined, it
            broke after the separator and left the dot hanging at the end of a
            line. As flex items they wrap as whole phrases instead, and the
            middot is drawn on the second one so it travels with it. */}
        <p class="footer__role">
          <span>{DOCTOR.qualifications}</span>
          <span>{DOCTOR.jobTitle}</span>
        </p>

        <ul class="footer__contact">
          <li>
            <Icon name="phone" size="sm" />
            <a href={telHref}>{PRACTICE.bookingPhoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size="sm" />
            <a href={`mailto:${PRACTICE.email}`}>{PRACTICE.email}</a>
          </li>
          <li>
            <Icon name="clock" size="sm" />
            <span>{PRACTICE.hoursDisplay}</span>
          </li>
        </ul>

        <address class="footer__address">
          {PRACTICE.address.street},<br />
          {PRACTICE.address.locality}, {PRACTICE.address.region}, Pakistan
        </address>
      </div>

      {/* Three columns of links rather than one flat row. With nine service
          pages plus the practice pages, a single centred line had become a
          paragraph of links — grouped under headings it reads as a site map,
          which is also what a crawler needs from a footer. */}
      <nav class="footer__nav" aria-label="Footer">
        {FOOTER_NAV.map((group) => (
          <div class="footer__group">
            <h2 class="footer__heading">{group.heading}</h2>
            <ul>
              {group.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="footer__base">
      <p class="footer__legal">
        &copy; {year} {DOCTOR.name}. All rights reserved. Information on this site is
        general and does not replace an individual consultation.
      </p>

      <ul class="footer__legal-links">
        {LEGAL_LINKS.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  /* Top corners only. The footer runs to the bottom of the viewport, so
     rounding the lower pair would just cut two notches of paper out of the
     window edge; curving the top is what makes it read as a panel the page
     rests on rather than a bar stuck to the end of it. */
  .footer {
    /* The deepest amethyst, not the mid one: on a white page this block is the
       only large area of colour, and it has to land as an anchor rather than as
       a purple panel. */
    background: var(--amethyst-900);
    color: #FFFFFF;
    /* Far tighter than a normal section's rhythm. As a curtain the footer's
       height is also the gap the page has to scroll past, so generous padding
       here reads as an empty screen rather than as breathing room. */
    padding-block: clamp(40px, 4.5vw, 60px);
    border-radius: clamp(24px, 3.5vw, 44px) clamp(24px, 3.5vw, 44px) 0 0;
  }

  /* The curtain. Fixed and behind the page, so the last section slides off it
     instead of pushing it down. `.page` reserves the height with its own bottom
     margin — see the .curtain rules in global.css.

     The flag is set by scripts/motion.ts only when the footer is short enough
     relative to the window to be worth uncovering. Without JS, or on a short or
     narrow viewport, this rule never applies and the footer sits in flow. */
  :root[data-curtain="on"] .footer {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 0;
  }

  /* The reveal. --curtain is how much of the footer the page has slid off,
     0 → 1, written by scripts/motion.ts; the contents ride up into place over
     that range instead of being dragged into view already finished.

     No transition: the value is a function of scroll position, so the motion
     is the reader's own. The multipliers land it at rest a little before the
     footer is fully uncovered — the last stretch should feel like the page
     settling, not like something still arriving. Opacity clamps on its own, so
     the over-unity factor is safe.

     Scoped to data-motion as well as data-curtain: with reduced motion the
     footer is simply uncovered, no fade, and the fallback of 1 means it is
     fully drawn whatever happens to the script. */
  :root[data-curtain="on"][data-motion="on"] .footer__inner {
    opacity: calc(var(--curtain, 1) * 1.8 - 0.25);
    transform: translateY(calc((1 - var(--curtain, 1)) * 32px));
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .footer__mark { width: 32px; height: 21px; }

  .footer__name {
    margin-top: var(--s-4);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -.02em;
    color: #FFFFFF;
  }

  /* Every text tone down here is a solid colour, not white at an opacity.
     Stacked alphas on a purple ground were what made the old footer read as
     washed out; these are picked to clear 7:1 on --amethyst-900. */
  .footer__role {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--s-3);
    margin-top: 4px;
    font-size: var(--fs-body-sm);
    color: #CFC7DE;
  }

  /* On the second chunk rather than between the two, so a wrap can never leave
     the dot stranded at the end of a line. Dimmer than the text it separates —
     it is punctuation, not a third item. */
  .footer__role span + span::before {
    content: "·";
    margin-right: var(--s-3);
    color: #9E92B8;
  }

  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: var(--s-5);
    font-size: var(--fs-body-sm);
  }
  .footer__contact li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: #E7E2F2;
  }
  .footer__contact :global(.icon) { flex: 0 0 auto; color: #9E92B8; }
  .footer__contact a { color: #E7E2F2; text-decoration: none; word-break: break-word; }

  .footer__address {
    margin-top: var(--s-4);
    font-style: normal;
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: #BEB4D2;
    max-width: 38ch;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5) var(--s-4);
  }

  /* Sentence case rather than the --fs-label small-caps treatment the rest of
     the site gives its eyebrows: these three are column headings in a site map,
     not captions, and at label size in uppercase they sat quieter than the
     links beneath them. Larger, cased, and in the display face so the weight
     reads as hierarchy rather than as emphasis. */
  .footer__heading {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -.01em;
    text-transform: none;
    color: #CFC7DE;
  }

  .footer__group ul {
    display: flex;
    flex-direction: column;
    margin-top: var(--s-2);
  }
  .footer__group a {
    display: block;
    padding-block: 7px;
    color: #E7E2F2;
    text-decoration: none;
    font-size: var(--fs-body-sm);
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease);
  }

  .footer__group a:hover,
  .footer__contact a:hover,
  .footer__legal-links a:hover {
    color: #FFFFFF;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The one rule in the footer, and it only has to separate the legal line —
     the groups above are already separated by space. */
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    margin-top: clamp(28px, 3.5vw, 40px);
    padding-top: var(--s-5);
    border-top: 1px solid rgba(255, 255, 255, .18);
  }

  .footer__legal {
    max-width: 72ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #BEB4D2;
    text-wrap: pretty;
  }

  .footer__legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .footer__legal-links a {
    color: #CFC7DE;
    text-decoration: none;
    font-size: 0.8125rem;
  }

  @media (max-width: 900px) {
    .footer__top { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .footer__nav { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
