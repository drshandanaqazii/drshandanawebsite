---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Motif from './Motif.astro';
import { DOCTOR, CREDENTIAL_BAR } from '../consts';
import portrait from '../assets/shandana-portrait.png';
---

<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__copy" data-reveal-group data-parallax="-38">
      <h1 class="display-xl" data-reveal>
        You don't have to keep <em>guessing</em>.
      </h1>

      <p class="hero__lede" data-reveal>
        <span class="hero__name">{DOCTOR.name}</span> is a consultant psychiatrist at Rehman Medical Institute,
        Hayatabad. Depression, anxiety, stress, and the conditions that quietly reshape
        an ordinary day: assessed properly, and explained in language you can actually use.
      </p>

      {/* The secondary sends people who are not ready to book to the answers —
          not knowing what an appointment involves is the usual reason for
          hesitating at this point. */}
      <div class="hero__actions" data-reveal>
        <Button href="/contact">Book a consultation</Button>
        <Button href="/faq" variant="ghost">Questions before booking</Button>
      </div>

      <p class="hero__meta" data-reveal>
        <Icon name="pin" size="sm" />
        <span>RMI, 5-B/2 Phase-V, Hayatabad, Peshawar</span>
      </p>
    </div>

    {/* A cut-out portrait: the panel behind it supplies the background the
        PNG does not have. */}
    {/* The whole arch-plus-portrait unit drifts, not the cut-out inside it —
        moving the portrait alone would break the way it stands on the panel. */}
    <figure class="hero__media" data-reveal="media" data-parallax="30">
      {/* The panel was the flattest surface on the page: a gradient and
          nothing else, for 530px. The brain sits in it rather than on the
          paper because this is the one ground already tinted — on white the
          same drawing would have to be so faint to stay quiet that it would
          disband into the page at the first sunlit screen. Placed high and
          off the right edge, so the portrait's head crosses it rather than
          standing in front of a complete shape. */}
      {/* `spark` runs one point of amethyst light around a circuit through the
          drawing — a signal crossing it, which is the one piece of movement on
          this panel. 22s is a deliberate crawl: at anything under about 15 the
          eye tracks it as an object moving and stops reading the headline. */}
      <Motif name="brain" class="hero__motif" spark={22} />

      <Image
        src={portrait}
        alt={`${DOCTOR.name}, consultant psychiatrist, in a white coat`}
        widths={[400, 550]}
        sizes="(max-width: 900px) 380px, 44vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>

  <div class="container">
    <div class="credbar" data-reveal-group data-parallax="-18">
      <ul class="credbar__degrees" data-reveal style="--reveal-from: 10px;">
        {CREDENTIAL_BAR.degrees.map((d) => (
          <li class="credential">{d}</li>
        ))}
      </ul>

      <p class="credbar__post" data-reveal style="--reveal-from: 10px;">
        {CREDENTIAL_BAR.role} at <em>{CREDENTIAL_BAR.institution}</em>
      </p>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(56px, 8vw, 104px); }

  /* Stretch, not centre: the panel takes its height from the copy column, so
     the two columns share a top and a bottom edge instead of floating past
     each other. */
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: stretch;
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* The two columns drift at opposite rates, so their edges can never stay
       flush. Centred in the stretched cell, the copy reads level against the
       panel at every scroll position instead of only one. */
    justify-content: center;
    gap: var(--s-5);
  }

  /* One step up from the 300 the display scale sets, and only here. The scale
     runs its largest sizes light on purpose, but this line is the first thing
     on the page and the only headline with nothing above it to lean on — at 300
     it read tentative, which is the wrong tone for a sentence whose whole job is
     to sound certain. 400 is the smallest move that fixes that; 500 at 76px
     stops being a voice and starts being a poster. The display scale itself is
     left alone, so every other heading still runs light. */
  .hero h1 { font-weight: 400; }

  .hero__lede {
    max-width: 46ch;
    font-size: 1.0625rem;
  }
  /* There is no second face to set the name apart with any more, so it is
     picked out the way a sans can: the display family at medium weight and full
     ink, against Inter at 400 in body grey. */
  .hero__name {
    font-family: var(--font-display);
    font-size: 1.08em;
    font-weight: 500;
    letter-spacing: -.01em;
    color: var(--ink);
  }

  /* Two pill buttons sit closer than a button and a bare phone link did — the
     wider gap was spacing two different kinds of thing. */
  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  .hero__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink-muted);
    font-size: var(--fs-body-sm);
  }
  .hero__meta :global(.icon) { flex: 0 0 auto; }

  /* A rounded panel filled with the tint, with the cut-out sitting inside it.
     The panel spans the full column so its edges line up with the copy and
     the credential bar below. */
  .hero__media {
    /* Positioning ancestor for the motif; the overflow below is what crops it
       against the panel's rounded edge, and the isolation is what keeps the
       motif's negative z-index inside this panel. */
    position: relative;
    isolation: isolate;
    width: 100%;
    /* No aspect-ratio: the height comes from the stretched grid row, which is
       what keeps the panel flush with the copy beside it. */
    height: 100%;
    /* Deliberately taller than the copy: the panel sets the row height, which
       is what gives the centred copy room to sit down off the nav. */
    min-height: clamp(440px, 41vw, 530px);
    overflow: hidden;
    border-radius: var(--r-hero);
    /* The portrait is a cut-out PNG, so this panel *is* its background — it is
       the one place on the page that cannot be white, or the white coat
       disappears into the page. Kept to the faintest amethyst tint that still
       holds the coat, deepening slightly at the foot where the coat is. */
    background:
      linear-gradient(
        172deg,
        var(--surface) 0%,
        var(--paper-deep) 42%,
        var(--amethyst-100) 100%
      );
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  /* Reached into from the parent rather than written as a bare `.hero__motif`.
     The class is passed to <Motif /> and lands on an element rendered by that
     component, which carries Motif's scope attribute and not this file's — so
     the obvious `.hero__motif { … }` compiles to a selector that matches
     nothing and the drawing falls back to its intrinsic size in the corner.
     `.hero__media` is this file's own element, so the descendant part is what
     keeps the rule scoped to this component.

     One selector for both the drawing and the light that travels it — see the
     note in Motif.astro on why they are two elements. Placing them together is
     what guarantees they stay in register. */
  .hero__media :global(.hero__motif) {
    top: -6%;
    right: -14%;
    width: 86%;
    /* Well above the .motif default of .03. It is drawn on the tint rather
       than on paper, so the gradient eats a good deal of it — and it is the
       one motif on the site with a light running over it, which only reads as
       a light on a line if the line under it is actually visible. Still low
       enough to stay texture: the coat in front of it is the subject. */
    --motif-opacity: .1;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    /* Contain, not cover: the panel's proportion now depends on the copy
       beside it, and a cover crop would zoom the cut-out by however much that
       proportion happened to change. Contained and bottom-anchored, she stands
       on the foot of the panel at any height, never cropped at the face. */
    object-fit: contain;
    object-position: 50% 100%;
  }

  /* Two voices: the degrees are enclosed chips, the appointment is set in the
     display serif, so the band reads like a byline rather than a row of tags. */
  .credbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3) var(--s-7);
    padding-block: var(--s-5);
    border-top: 1px solid var(--hairline);
  }

  .credbar__degrees {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex: 0 0 auto;
  }
  /* Set as tinted chips rather than a bulleted run: qualifications are awarded
     things, and giving each its own enclosure reads that way. The bullet the
     run used to need is now the gap between them. */
  .credbar__degrees li {
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: var(--amethyst-50);
    box-shadow: inset 0 0 0 1px rgba(62, 46, 92, .08);
    color: var(--amethyst-900);
    /* Set as written, not shouted: the initialisms are already capitals, and
       forcing the rest up turns a qualification into a label. Sentence case
       also needs less tracking than caps do. */
    text-transform: none;
    letter-spacing: .01em;
    font-size: var(--fs-body-sm);
  }

  .credbar__post {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: -.01em;
    color: var(--ink);
    text-wrap: balance;
  }
  /* The institution carries the weight; emphasis colour belongs to the main
     headings only. */
  .credbar__post em { font-style: normal; font-weight: 500; }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    /* Stacked, there is no second column to match, so the panel goes back to
       carrying its own proportion. */
    .hero__media {
      order: -1;
      max-width: 380px;
      margin-inline: auto;
      height: auto;
      min-height: 0;
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 640px) {
    .credbar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-3);
    }
  }
</style>
