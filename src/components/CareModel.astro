---
/**
 * The three-step care model, on the homepage.
 *
 * It used to have a `page` variant for /treatment, where it was the body of the
 * page rather than a summary of it, and a link onward to that page. Both went
 * when /treatment did — this is now the only place the model is stated, so it
 * is stated in full and links nowhere.
 */
import Icon from './Icon.astro';
import { CARE_STEPS } from '../consts';
---

<section class="section" id="care" aria-labelledby="care-heading">
  <div class="container">
    <div class="container-narrow statement" style="padding-inline: 0;" data-reveal-group data-parallax="-26">
      <p class="eyebrow" data-reveal>How treatment works</p>
      <h2 class="display-lg" id="care-heading" data-reveal>
        Three things happen, in <em>order</em>.
      </h2>
      <p class="prose" style="margin-top: var(--s-2);" data-reveal>
        Psychiatry is not only prescriptions. It starts with understanding what is actually
        happening, and only then decides what, if anything, needs to be prescribed.
      </p>
    </div>

    {/* Deliberately not the card grid used above. That grid is six parallel
        things, any of which might be yours; this is one path walked in a fixed
        order, so it is drawn as a path: a line that fills as you descend, a
        marker at each stop, and no photographs to make the three look
        interchangeable. */}
    <ol class="journey">
      {CARE_STEPS.map((step, i) => (
        <li class="step" id={step.slug} data-reveal-group>
          {/* data-reveal sits on the rail, not on the disc inside it: the
              stagger in motion.ts only tracks a group's direct children, and a
              nested [data-reveal] would never be brought in. */}
          <span class="step__rail" aria-hidden="true" data-reveal>
            <span class="step__disc"><Icon name={step.icon} /></span>
            {i < CARE_STEPS.length - 1 && (
              <span class="step__track" data-progress><span class="step__fill" /></span>
            )}
          </span>

          <div class="step__body" data-reveal>
            {/* Three rates over one step: the numeral lags furthest behind, the
                copy drifts against the scroll, the marker stays pinned to the
                path. The spread between them is the depth — the numeral on its
                own would just be a moving number. */}
            <span class="step__ghost" aria-hidden="true" data-parallax="72">{step.number}</span>

            <div class="step__text" data-parallax="-14">
              <h3 class="display-md step__title">
                {step.title} <em>{step.titleEm}</em>
              </h3>
              <p class="prose">{step.body}</p>
              <p class="step__note">{step.note}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .journey {
    --rail: 56px;
    --step-gap: clamp(56px, 8vw, 104px);
    --track-inset: 10px;
    max-width: 880px;
    margin: clamp(56px, 7vw, 88px) auto 0;
  }

  .step {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: clamp(20px, 3.5vw, 48px);
    padding-bottom: var(--step-gap);
  }
  .step:last-child { padding-bottom: 0; }

  .step__rail { position: relative; }

  .step__disc {
    display: grid;
    place-items: center;
    width: var(--rail);
    height: var(--rail);
    border-radius: 50%;
    background: var(--amethyst-50);
    color: var(--amethyst-900);
  }

  /* One segment per gap between markers, rather than a single line behind the
     whole list. The rail stretches to its step's copy, which is taller than the
     gap, so a single absolute spine would overshoot the final marker by the
     height of the last paragraph. Segment by segment, the path can only ever
     end where it should — and the last step is given no segment at all. */
  .step__track {
    position: absolute;
    top: calc(var(--rail) + var(--track-inset));
    bottom: calc(var(--track-inset) - var(--step-gap));
    left: calc(var(--rail) / 2 - 1px);
    width: 2px;
    background: var(--hairline);
    border-radius: 1px;
  }

  /* Drawn in as the reader descends. --progress is written by
     scripts/motion.ts; the resting value here is 1, so with no JS the path is
     simply complete. See the rule in motion.css that flips the default. */
  .step__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(to bottom, var(--amethyst-600), var(--amethyst-100));
    transform: scaleY(var(--progress, 1));
    transform-origin: top;
  }

  .step__body {
    position: relative;
    /* Optically level with the disc, which has 16px of its own padding above
       the icon. */
    padding-top: 6px;
  }

  .step__ghost {
    position: absolute;
    /* Shallow enough that the first numeral cannot ride up into the section
       intro above it — the journey's top margin is the whole budget. */
    top: -0.28em;
    right: 0;
    z-index: 0;
    font-family: var(--font-display);
    font-size: clamp(88px, 14vw, 190px);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.04em;
    /* Gilt rather than amethyst: on white this is the one warm mark on the
       page, and at 190px it has to stay faint enough not to compete with the
       heading beside it. Light weight as well as low opacity — a 190px numeral
       at 400 would still read as a second column of type. */
    color: var(--gilt-600);
    opacity: 0.2;
    pointer-events: none;
    user-select: none;
  }

  /* Positioned, so it paints over the absolutely positioned numeral behind it. */
  .step__text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  /* Held short of the numeral hanging at the right of the column. */
  .step__title {
    max-width: 22ch;
  }

  .step__note {
    margin-top: var(--s-2);
    padding-top: var(--s-3);
    border-top: 1px solid var(--hairline);
    max-width: 46ch;
    font-size: var(--fs-body-sm);
    font-style: italic;
    color: var(--ink-muted);
  }

  @media (max-width: 700px) {
    .journey {
      --rail: 44px;
      --step-gap: clamp(44px, 11vw, 64px);
    }
    .step__title { max-width: none; }
    .step__ghost {
      /* On a narrow column a right-hung numeral collides with the heading;
         tucked in behind it, it stays a texture instead of an obstacle. */
      top: -0.3em;
      right: auto;
      left: -0.08em;
      font-size: clamp(76px, 22vw, 120px);
      opacity: 0.06;
    }
  }
</style>
