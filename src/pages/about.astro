  /* ------------------------------------------------------------------------
     Teaching and advocacy

     The portrait explorer holds the roles and their related sessions.
     ------------------------------------------------------------------------ */
  .teach__lede { max-width: 62ch; color: var(--ink-body); }

  /* ------------------------------------------------------------------------
     What she treats — the section drawn as a brain

     No tinted slab: the background *is* the drawing. The silhouette is
     stretched to the section's own box so the band is literally enclosed by
     it, with a faint wash pooled inside the contour so the shape reads as a
     shape rather than as loose line work.
     ------------------------------------------------------------------------ */
  .focus-section {
    position: relative;
    isolation: isolate;
    padding-block: clamp(48px, 6vw, 88px) clamp(72px, 10vw, 128px);
    overflow: hidden;
  }

  /* Stretched to all four edges. `preserveAspectRatio="none"` on the SVG is
     what makes width/height 100% actually fill rather than letterbox. */
  /* Full height of the band, but held off the viewport's left and right edges
     so the silhouette reads as a shape sitting on the page rather than as a
     graphic that ran out of room. The inset scales with the viewport, so the
     brain stays roughly as wide as the content it encloses. */
  .brain {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    z-index: -1;
    /* Explicit width, centred. Left/right insets with `width: auto` would not
       do it: an SVG with a viewBox has an intrinsic aspect ratio, so `auto`
       resolves to height × ratio and the box only moves off the left edge. */
    width: calc(100% - 2 * clamp(16px, 7vw, 180px));
    height: 100%;
    fill: none;
    pointer-events: none;
  }

  /* The enclosing contour, and the only filled part of the drawing: a wash
     inside the silhouette, so the content sits *within* the brain instead of
     merely in front of some lines. */
  .brain__shell {
    fill: rgba(124, 92, 176, .05);
    stroke: url(#brain-stroke);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .55;
  }

  .brain__lines {
    stroke: url(#brain-stroke);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: .2;
    /* The folds are cleared out of the middle, where the heading, lede and
       button sit — they stay at full strength out towards the contour, which
       is where they are doing the drawing's work anyway. */
    mask-image: radial-gradient(
      42% 46% at 50% 40%,
      transparent 0%,
      rgba(0, 0, 0, .35) 62%,
      #000 100%
    );
  }

  /* The stretch would otherwise smear the strokes — thick where the drawing is
     scaled up, hairline where it is squeezed. Set on the paths themselves
     because vector-effect does not inherit from the group. */
  .brain__shell path,
  .brain__lines path { vector-effect: non-scaling-stroke; }

  /* The synapse points, stronger than the lines so the drawing has somewhere
     for the eye to land. */
  .brain__nodes {
    fill: var(--amethyst-600);
    opacity: .3;
  }

  @media (max-width: 640px) {
    .brain { display: none; }
  }

  .focus-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-4);
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: clamp(48px, 6vw, 72px);
    text-align: center;
  }

  /* An outlined chip rather than the site's plain .eyebrow: centred over a
     centred headline, a bare line of text has nothing holding it down. */
  .focus-eyebrow {
    padding: 5px 16px;
    border-radius: var(--r-pill);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--amethyst-100);
