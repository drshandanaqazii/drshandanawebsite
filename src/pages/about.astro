  }

  .focus-lede { color: var(--ink-body); max-width: 46ch; }

  /* Centred flex wrap, not a grid: the rows are meant to come out at unequal
     widths so the block reads as a scattered cloud. The max-width is what
     decides how many rows that is — widen it and the cloud flattens. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--s-4) var(--s-3);
    max-width: 860px;
    margin-inline: auto;
