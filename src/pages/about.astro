  @media (max-width: 560px) {
    .qual { grid-template-columns: minmax(0, 1fr); }
    .qual__item--tl { grid-row: 2; }
    .qual__item--tr { grid-row: 3; }
    .qual__item--bl { grid-row: 4; }
    .qual__item--br { grid-row: 5; }
    .qual__item--tl,
    .qual__item--tr,
    .qual__item--bl,
    .qual__item--br { grid-column: 1; }

    /* Phone only: the four cards stack on one another as you scroll. Each pins
       a little lower than the one before, so the card arriving slides over the
       one already parked and leaves its top edge showing — the section reads as
       one deck of credentials rather than four full screens of scrolling.

       Sticky, not a scroll-driven script: the offsets are the whole effect, and
       the grid container is already `position: relative`, so each <li> pins
       against the diagram it belongs to. Paint order is DOM order, which is
       chronological, so a later card is always the one on top.

       --stack-top clears the fixed nav. --stack-step is both the offset between
       pins and the strip of each parked card left visible. */
    .qual {
      --stack-top: 86px;
      --stack-step: 16px;
      row-gap: 0;
    }
    /* row-gap: 0 took the space under the seal with it — the cards set their own
       spacing here, so the seal has to set its own too. */
    .qual__core { margin-bottom: var(--s-6); }
    .qual__item {
      position: sticky;
      /* Opaque already via --surface, but stated so a parked card can never
         show the card sliding beneath it. */
      background: var(--surface);
      /* The travel between one card and the next. Without it the cards pin
         nose-to-tail and nothing appears to stack. */
      margin-bottom: clamp(24px, 6vw, 36px);
    }
    .qual__item--tl { top: var(--stack-top); }
    .qual__item--tr { top: calc(var(--stack-top) + var(--stack-step)); }
    .qual__item--bl { top: calc(var(--stack-top) + var(--stack-step) * 2); }
    .qual__item--br {
      top: calc(var(--stack-top) + var(--stack-step) * 3);
      margin-bottom: 0;
    }
  }
