  }

  @media (max-width: 900px) {

    /* Stacked, the portrait keeps its source position at the top: at full width
       it is the introduction, whereas underneath the four facts it would read
       as a footnote. */
    .bio-card { grid-template-columns: 1fr; }
    .bio-card__media {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    /* The diagram needs a middle column to point at. Below this there is not
       room for one, so it becomes the claim followed by the four credentials
       in two columns — and the elbows and the ruled ground, which only mean
       anything in the radial arrangement, are dropped rather than redrawn. */
    .qual {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Both resets matter: the capped columns become full-width here, and the
         desktop `1fr 1fr` rows would otherwise force the core and the two
         credential rows to equal heights across three rows. */
      grid-template-rows: auto;
      justify-content: stretch;
      align-items: start;
      gap: var(--s-6) var(--s-5);
    }
    .qual::before { display: none; }
    .qual__lead { display: none; }

    /* The seal keeps its square; only its placement changes. Without the reset
       the desktop rule would still span it across both rows. */
    .qual__core {
      grid-column: 1 / -1;
      grid-row: 1;
      align-self: center;
    }

    /* Stacked, the items are ordinary left-aligned blocks again — the
       justify-self that pushed them against the seal would now pull the left
       column away from the text above it. */
    .qual__item {
      justify-self: start;
      max-width: none;
    }
    .qual__item--tl { grid-column: 1; grid-row: 2; }
    .qual__item--tr { grid-column: 2; grid-row: 2; }
    .qual__item--bl { grid-column: 1; grid-row: 3; }
    .qual__item--br { grid-column: 2; grid-row: 3; }
  }

  /* At roughly one or two tags to a row the scatter stops reading as a cloud
     and starts reading as misalignment — tilted pills next to a straight screen
     edge, with the vertical offsets pulling neighbouring rows into each other.
     On phones the tags sit flat in honest rows instead. */
  @media (max-width: 640px) {

    .tags { gap: var(--s-2); }
    .tag {
      padding: 0 18px;
      transform: none;
    }
    .tag:hover,
    .tag:focus-visible { transform: translateY(-3px); }
