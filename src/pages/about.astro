  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: var(--r-pill);
    color: var(--amethyst-900);
    font-size: var(--fs-body-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transform: translateY(var(--dy, 0)) rotate(var(--rot, 0deg));
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  /* Hover straightens the tag and lifts it out of the pile. The rotation is
     what makes the cloud look casual; removing it on hover is what makes the
     individual tag look clickable. */
  .tag:hover,
  .tag:focus-visible {
    transform: translateY(calc(var(--dy, 0px) - 3px)) rotate(0deg);
  }

  .tag--t1 {
    background: var(--surface);
