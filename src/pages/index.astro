---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CareModel from '../components/CareModel.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Teaching from '../components/Teaching.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';

/* The homepage carries every subject in short form and links onward to the page
   that covers it. It does not carry FAQPage markup — /faq does, and these five
   questions are a subset of that page's. See the note in consts.ts.

   ⚠️ <Testimonials /> is on the page at the owner's request, and TESTIMONIALS
   still holds lorem ipsum. Before launch those three entries have to become
   real reviews given with written consent, or the section has to come back out:
   invented reviews under a named, practising doctor's byline are misleading and
   a medical-advertising problem. */
---

<BaseLayout>
  <Hero />
  <About />
  {/* Directly after the introduction, not later down the page: it is the second
      half of who she is, and it reads as a digression anywhere the reader has
      already moved on to what she treats. Links to /about#teaching, which is
      where the full version and the photographs live. */}
  <Teaching />
  <Services />
  <CareModel />
  {/* After the care model and before the questions: the reviews answer "does
      this work for people like me", which is the doubt left once someone has
      read what happens, and which comes before the practical questions. */}
  <Testimonials />
  <Faq />
  <Contact />
</BaseLayout>
