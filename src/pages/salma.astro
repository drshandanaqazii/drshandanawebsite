---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaHeader from '../components/MediaHeader.astro';
import ClinicGallery from '../components/ClinicGallery.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import { DOCTOR, SALMA, PAGE_SEO } from '../consts';
import headerImage from '../assets/about-plant.jpg';
import portrait from '../assets/about-main-portrait.jpeg';

const trail = [{ name: 'Clinic', href: '/salma' }];
const highlights = [
  { icon: 'people' as const, title: 'Care with Dr. Qazi', body: 'Consultations for adolescents and adults.' },
  { icon: 'mind' as const, title: 'A plan for you', body: 'Assessment, treatment and follow-up care.' },
  { icon: 'heart' as const, title: 'Women’s mental health', body: 'Including perinatal and postnatal care.' },
];
---

<BaseLayout title={PAGE_SEO.salma.title} description={PAGE_SEO.salma.description} pageType="AboutPage" breadcrumbs={trail}>
  <MediaHeader
    image={headerImage}
    imageAlt=""
    imagePosition="50% 42%"
    trail={trail}
    title="Salma Psychiatric"
    titleEm="Clinic"
    lede="The online clinic of Dr. Shandana Qazi, Consultant Psychiatrist."
    scrollTo="clinic"
    scrollLabel="Explore the clinic"
  />

  {/* The split portrait panel and ruled facts follow the About page. */}
  <section class="section clinic-intro" id="clinic" aria-labelledby="clinic-heading">
    <div class="container">
      <div class="clinic-card">
        <figure class="clinic-card__media" data-reveal="media">
          <Image src={portrait} alt="Dr. Shandana Qazi seated at her desk" widths={[480, 720, 1000]} sizes="(max-width: 800px) 100vw, 45vw" loading="lazy" />
          <figcaption>{DOCTOR.name}<span>{DOCTOR.qualifications}</span></figcaption>
        </figure>
        <div class="clinic-card__copy" data-reveal-group>
          <p class="eyebrow" data-reveal>Her practice</p>
          <h2 class="display-md" id="clinic-heading" data-reveal>A place to feel <em>heard</em>.</h2>
          <p class="prose" data-reveal>
            Salma Psychiatric Clinic is an approachable, non-judgemental and warm space, with
            individualised management plans for personal growth, resilience building and better stress coping.
          </p>
          <ul class="clinic-facts" data-reveal>
            {highlights.map((fact) => (
              <li>
                <span class="clinic-facts__icon"><Icon name={fact.icon} size="sm" /></span>
                <div><h3>{fact.title}</h3><p>{fact.body}</p></div>
              </li>
            ))}
          </ul>
          <div class="clinic-actions" data-reveal>
            <Button href="/appointments" variant="ghost" book>Book an appointment</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Dr. Qazi's own words on why the clinic is named Salma. */}
  {SALMA.story.published && SALMA.story.body.length > 0 && (
    <section class="section clinic-story" id="name" aria-labelledby="name-heading">
      <div class="container">
        <div class="story">
          <div class="story__head" data-reveal-group>
            <p class="eyebrow" data-reveal>Behind the name</p>
            <h2 class="display-md" id="name-heading" data-reveal>Why <em>Salma</em>.</h2>
            <div class="story__meaning" data-reveal aria-hidden="true">
              <span class="story__word">Salma</span>
              <span class="story__eq">means</span>
              <span class="story__word story__word--em">peace</span>
            </div>
          </div>

          <div class="story__body" data-reveal-group>
            <blockquote class="story__lede" data-reveal>{SALMA.story.body[0]}</blockquote>

            <div class="story__pair">
              {SALMA.story.body.slice(1, 3).map((paragraph, i) => (
                <div class="story__card" data-reveal>
                  <span class="story__card-icon"><Icon name={i === 0 ? 'heart' : 'mind'} size="sm" /></span>
                  <p>{paragraph}</p>
                </div>
              ))}
            </div>

            {SALMA.story.body[3] && (
              <p class="story__closing" data-reveal>{SALMA.story.body[3]}</p>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <ClinicGallery />

  {/* The homepage contact split, with its ruled details and pill buttons. */}
  <section class="section" id="visit" aria-labelledby="visit-heading">
    <div class="container visit">
      <div class="visit__copy" data-reveal-group>
        <p class="eyebrow" data-reveal>Your visit</p>
        <h2 class="display-md" id="visit-heading" data-reveal>Start with a <em>conversation</em>.</h2>
        <p class="prose" data-reveal>Choose a day and time that suits you, and the clinic will confirm your appointment.</p>
        <div class="clinic-actions" data-reveal>
          <Button href="/appointments" book>Book an appointment</Button>
        </div>
      </div>
      <div class="visit__panel" data-reveal>
        <h3 class="card-title">Salma Psychiatric Clinic</h3>
        <ul class="visit__details">
          <li>
            <Icon name="pin" size="sm" />
            <div><h4>Where</h4>
              <p>An online clinic: consultations are held by video, from wherever you are.</p>
            </div>
          </li>
          <li>
            <Icon name="clock" size="sm" />
            <div><h4>Clinic hours</h4><p>{SALMA.hoursDisplay}</p></div>
          </li>
          {SALMA.located && SALMA.phoneDisplay && (
            <li><Icon name="phone" size="sm" /><div><h4>Telephone</h4><a href={'tel:' + SALMA.phone.replace(/\s/g, '')}>{SALMA.phoneDisplay}</a></div></li>
          )}
        </ul>
        <a class="visit__social" href="/appointments" data-book>
          <span class="visit__social-mark" aria-hidden="true"><Icon name="clipboard" /></span>
          <span>Book an appointment<small>Choose a day and time</small></span>
          <span class="visit__arrow"><Icon name="arrow" size="sm" /></span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .clinic-intro { padding-top: 0; padding-bottom: clamp(56px, 7vw, 96px); }
  .clinic-card {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    overflow: hidden;
    border-radius: var(--r-hero);
    background: var(--amethyst-50);
    box-shadow: inset 0 0 0 1px var(--amethyst-100), var(--shadow-card);
  }
  .clinic-card__media { position: relative; min-height: 520px; }
  .clinic-card__media :global(img) { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: 55% 57%; }
  .clinic-card__media figcaption {
    position: absolute;
    inset: auto 20px 20px;
    padding: 14px 20px;
    border-radius: var(--r-media);
    background: rgba(255, 255, 255, .94);
    color: var(--ink);
    font-weight: 500;
    font-size: var(--fs-body-sm);
  }
  .clinic-card__media figcaption span { display: block; margin-top: 3px; color: var(--ink-muted); font-weight: 400; font-size: .75rem; }
  .clinic-card__copy { display: flex; flex-direction: column; justify-content: center; gap: var(--s-4); padding: clamp(28px, 4vw, 56px); }
  .clinic-card__copy .prose { max-width: 45ch; }
  .clinic-facts { display: flex; flex-direction: column; margin-top: var(--s-2); }
  .clinic-facts li { display: flex; align-items: flex-start; gap: var(--s-4); padding-block: 14px; border-top: 1px solid var(--amethyst-100); }
  .clinic-facts__icon { display: grid; place-items: center; flex: 0 0 34px; height: 34px; border-radius: 50%; background: var(--surface); color: var(--amethyst-600); }
  .clinic-facts h3, .visit__details h4 { font-family: var(--font-sans); font-size: var(--fs-body-sm); font-weight: 600; margin-bottom: 3px; }
  .clinic-facts p { font-size: var(--fs-body-sm); color: var(--ink-body); }
  .clinic-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .clinic-story { padding-top: 0; padding-bottom: clamp(56px, 7vw, 96px); }
  .story {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 72px);
    padding: clamp(28px, 5vw, 64px);
    border-radius: var(--r-hero);
    background: linear-gradient(160deg, var(--amethyst-50), #fff 80%);
    box-shadow: inset 0 0 0 1px var(--amethyst-100), var(--shadow-card);
  }
  .story__head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-4); position: sticky; top: 112px; align-self: start; }
  .story__meaning {
    display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
    margin-top: var(--s-4); padding: 22px 26px;
    border-radius: var(--r-media); background: #fff;
    box-shadow: inset 0 0 0 1px var(--amethyst-100);
  }
  .story__word { font-family: var(--font-display); font-size: clamp(1.9rem, 3.4vw, 2.6rem); line-height: 1.1; color: var(--amethyst-900); }
  .story__word--em { color: var(--amethyst-600); font-style: italic; }
  .story__eq { font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); }
  .story__body { display: flex; flex-direction: column; gap: var(--s-6, 28px); }
  .story__lede {
    margin: 0; padding-left: clamp(18px, 2.5vw, 28px);
    border-left: 3px solid var(--amethyst-600);
    font-family: var(--font-display); font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.55; color: var(--amethyst-900);
  }
  .story__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  .story__card {
    display: flex; flex-direction: column; gap: var(--s-3);
    padding: 24px; border-radius: var(--r-media); background: #fff;
    box-shadow: inset 0 0 0 1px var(--amethyst-100);
  }
  .story__card-icon { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--amethyst-50); color: var(--amethyst-600); }
  .story__card p { color: var(--ink-body); line-height: 1.65; }
  .story__closing {
    margin: 0; padding: clamp(24px, 3vw, 36px);
    border-radius: var(--r-media); background: var(--amethyst-900); color: #fff;
    font-family: var(--font-display); font-size: clamp(1.25rem, 2.2vw, 1.7rem); line-height: 1.35;
  }
  .visit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .visit__copy { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-4); }
  .visit__copy .prose { max-width: 38ch; }
  .visit__panel { padding: clamp(24px, 3vw, 40px); border-radius: var(--r-hero); background: var(--amethyst-50); box-shadow: inset 0 0 0 1px var(--amethyst-100); }
  .visit__details { margin-top: var(--s-5); }
  .visit__details li { display: flex; align-items: flex-start; gap: var(--s-4); padding-block: var(--s-4); border-top: 1px solid var(--amethyst-100); }
  .visit__details :global(.icon) { flex: 0 0 auto; color: var(--amethyst-600); margin-top: 2px; }
  .visit__details p, .visit__details address, .visit__details a { font-size: var(--fs-body-sm); color: var(--ink-body); font-style: normal; }
  .visit__social { display: flex; align-items: center; gap: 12px; padding-top: 20px; margin-top: 4px; border-top: 1px solid var(--amethyst-100); text-decoration: none; font-size: var(--fs-body-sm); color: var(--amethyst-900); font-weight: 500; }
  .visit__social small { display: block; margin-top: 4px; color: var(--ink-muted); font-weight: 400; overflow-wrap: anywhere; }
  .visit__social-mark { display: grid; place-items: center; flex: 0 0 38px; width: 38px; height: 38px; border-radius: 50%; background: var(--surface); color: var(--amethyst-900); }
  .visit__social-mark svg { width: 20px; height: 20px; }
  .visit__arrow { display: grid; place-items: center; flex: 0 0 36px; height: 36px; margin-left: auto; border-radius: 50%; color: white; background: var(--amethyst-900); }
  .visit__social:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 800px) {
    .clinic-card, .visit, .story, .story__pair { grid-template-columns: minmax(0, 1fr); }
    .story__head { position: static; }
    .clinic-card__media { min-height: 0; height: clamp(320px, 70vw, 460px); }
    .clinic-card__media :global(img) { object-position: 55% 52%; }
  }
  @media (max-width: 640px) {
    .clinic-story > .container { padding-inline: 10px; }
    .story { padding: 22px 14px; gap: 24px; }
    .story__lede { padding-left: 14px; }
    .story__lede, .story__card p, .story__closing { text-align: justify; hyphens: auto; }
  }
</style>
