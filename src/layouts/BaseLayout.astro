---
import '../styles/global.css';
import '../styles/motion.css';
import StructuredData from '../components/StructuredData.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE, SEO, DOCTOR, BOOKING_VENUE, SALMA } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Set false on pages that should not be indexed (404, thank-you pages). */
  index?: boolean;

  /* --- Structured data. Passed straight through to StructuredData.astro. --- */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'MedicalWebPage';
  /** Levels below the root only — "Home" is prepended for you. */
  breadcrumbs?: readonly { name: string; href: string }[];
  faqs?: readonly { q: string; a: string }[];
  condition?: { name: string; alternateName: readonly string[]; description: string };

  /** Extra class on <body>, for the few pages that need a different ground. */
  bodyClass?: string;
}

const {
  title = SEO.title,
  description = SEO.description,
  index = true,
  pageType = 'WebPage',
  breadcrumbs = [],
  faqs = [],
  condition,
  bodyClass,
} = Astro.props;

/* Trailing slash stripped so a page is never claimed by two canonical URLs —
   this has to match the `@id`s used in the JSON-LD, which derive from it. */
const canonical =
  new URL(Astro.url.pathname, Astro.site ?? SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImage = new URL('/og-image.jpg', Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {index
      ? <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
      : <meta name="robots" content="noindex, nofollow" />}

    <!-- Local signals. Legacy tags, but still parsed by several regional crawlers
         and harmless for Google. The authoritative signal is the JSON-LD below. -->
    <meta name="geo.region" content="PK-KP" />
    <meta name="geo.placename" content="Peshawar" />
    {SALMA.located && <>
      <meta name="geo.position" content={`${BOOKING_VENUE.geo.lat};${BOOKING_VENUE.geo.lng}`} />
      <meta name="ICBM" content={`${BOOKING_VENUE.geo.lat}, ${BOOKING_VENUE.geo.lng}`} />
    </>}
    <meta name="author" content={DOCTOR.name} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={DOCTOR.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SEO.ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts. preconnect first so the stylesheet request isn't blocked on DNS. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Both are variable. Outfit is requested from 200 because the ghost
        numerals in the care section set it there, and the display steps run at
        300 — trimming the low end of the range would silently thicken both. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..600&family=Outfit:wght@200..600&display=swap"
    />

    <StructuredData
      canonical={canonical}
      title={title}
      description={description}
      pageType={pageType}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      condition={condition}
    />

    <!-- Motion opt-in. Every hidden-then-revealed style is scoped to this flag,
         so it must be set before first paint: hence inline, in the head, and
         not in the bundled module. If this script never runs, the page renders
         fully visible and static. See src/styles/motion.css. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-motion', 'on');
      }
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    {/* .page is the sheet that scrolls over the fixed footer — see the curtain
        note in global.css. The nav is inside it so it rides on the same white
        ground as the content, with no seam between them. Every page shares this
        shell; a page's own markup is only what goes inside <main>. */}
    <div class="page">
      <Nav />
      <main id="main"><slot /></main>
    </div>

    <Footer />

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
